+use super::*;
+use crate::{NativeOccurrenceKind, NativeSessionSource, NativeSourcePlacement};
+use codex_protocol::ThreadId;
+
+fn labels() -> NativeSessionContext {
+    let id = ThreadId::new();
+    NativeSessionContext::new(id, id, None)
+}
+
+#[test]
+fn history_reopening_is_fresh_birth_not_resume() {
+    let history = labels();
+    let (_first_owner, first) = NativeSessionSource::birth_root(history).unwrap();
+    let (_second_owner, second) = NativeSessionSource::birth_root(history).unwrap();
+    assert_ne!(
+        first.actor_context().unwrap().actor(),
+        second.actor_context().unwrap().actor()
+    );
+    assert_eq!(first.context(), second.context());
+    assert_eq!(second.lifecycle().kind(), NativeOccurrenceKind::Birth);
+    assert!(second.original_birth_occurrence().is_some());
+}
+
+#[test]
+fn child_ancestry_uses_retained_instances_not_history_labels() {
+    let (_owner, root) = NativeSessionSource::birth_root(labels()).unwrap();
+    let parent = root.parent_reference().unwrap();
+    let (_child_owner, child) = NativeSessionSource::birth_child(labels(), &parent).unwrap();
+    let context = child.actor_context().unwrap();
+    assert_eq!(context.root(), root.actor_context().unwrap().actor());
+    assert_eq!(
+        context.direct_parent(),
+        Some(root.actor_context().unwrap().actor())
+    );
+    assert_ne!(context.history_labels(), root.context());
+}
+
+#[test]
+fn ancestor_closing_blocks_birth_even_with_live_immediate_parent() {
+    let (owner, root) = NativeSessionSource::birth_root(labels()).unwrap();
+    let (_child_owner, child) =
+        NativeSessionSource::birth_child(labels(), &root.parent_reference().unwrap()).unwrap();
+    let child_parent = child.parent_reference().unwrap();
+    owner.begin_closing().unwrap();
+    assert!(!child_parent.is_live());
+    assert!(matches!(
+        NativeSessionSource::birth_child(labels(), &child_parent),
+        Err(NativeContextError::ClosingAncestor)
+    ));
+    // Final-event identity remains readable; identity data does not keep admission live.
+    assert!(root.actor_context().is_ok());
+}
+
+#[test]
+fn retained_reference_does_not_extend_owner_lifetime() {
+    let (owner, root) = NativeSessionSource::birth_root(labels()).unwrap();
+    let parent = root.parent_reference().unwrap();
+    drop(owner);
+    assert!(!parent.is_live());
+    assert!(NativeSessionSource::birth_child(labels(), &parent).is_err());
+}
+
+#[test]
+fn unavailable_context_cannot_become_parent_or_canonical_context() {
+    let (_owner, source) =
+        NativeSessionSource::start(labels(), NativeSourcePlacement::ContextUnavailable).unwrap();
+    assert_eq!(
+        source.lifecycle().kind(),
+        NativeOccurrenceKind::ContextUnavailable
+    );
+    assert!(source.original_birth_occurrence().is_none());
+    assert_eq!(source.actor_context(), Err(NativeContextError::Unavailable));
+    assert!(matches!(
+        source.parent_reference(),
+        Err(NativeContextError::Unavailable)
+    ));
+}
+
+#[test]
+fn raw_occurrence_encoding_is_injective_and_retains_tuple() {
+    let (_owner, source) = NativeSessionSource::birth_root(labels()).unwrap();
+    let id = source.actor_context().unwrap().actor();
+    let event = id.canonical_event_id();
+    assert_eq!(&event[..16], &id.source_uuid_bytes());
+    assert_eq!(&event[16..24], &id.serial().get().to_be_bytes());
+    assert_eq!(&event[24..], &[0; 8]);
+    assert_eq!(&id.canonical_launch_id()[16..], &[0; 16]);
+    assert_eq!(id.source_uuid_bytes()[6] >> 4, 4);
+    assert_eq!(id.source_uuid_bytes()[8] >> 6, 2);
+    let context = source.actor_context().unwrap().canonical_bytes();
+    assert_eq!(&context[..8], b"CDXCTX01");
+    assert_eq!(context.len(), 8 + 32 + 32 + 1 + 16 + 16 + 1);
+    assert_eq!(&context[8..40], &event);
+}
+
+#[test]
+fn birth_and_closing_share_the_actual_linearization_gate() {
+    let (owner, root) = NativeSessionSource::birth_root(labels()).unwrap();
+    let parent = root.parent_reference().unwrap();
+    let (entered_send, entered_recv) = std::sync::mpsc::channel();
+    let (release_send, release_recv) = std::sync::mpsc::channel();
+    let birth = std::thread::spawn(move || {
+        Actor::birth_with(
+            crate::native_occurrence::next_id(),
+            labels(),
+            Some(&parent),
+            || {
+                entered_send.send(()).unwrap();
+                release_recv.recv().unwrap();
+            },
+        )
+        .unwrap()
+    });
+    entered_recv.recv().unwrap();
+    assert!(matches!(
+        GRAPH.try_lock(),
+        Err(std::sync::TryLockError::WouldBlock)
+    ));
+    let closing = std::thread::spawn(move || {
+        owner.begin_closing().unwrap();
+        owner
+    });
+    release_send.send(()).unwrap();
+    let (_child_owner, child) = birth.join().unwrap();
+    let _owner = closing.join().unwrap();
+    assert!(!child.parent_reference().unwrap().is_live());
+}
+
+#[test]
+fn delayed_subject_never_becomes_replacement_with_same_history_id() {
+    let history = labels();
+    let (old_owner, old) = NativeSessionSource::birth_root(history).unwrap();
+    let subject = old.subject();
+    drop(old_owner);
+    let (_new_owner, replacement) = NativeSessionSource::birth_root(history).unwrap();
+    assert_ne!(subject, replacement.subject());
+    assert_eq!(subject.context().unwrap(), old.actor_context().unwrap());
+    assert_ne!(
+        subject.context().unwrap().actor(),
+        replacement.actor_context().unwrap().actor()
+    );
+}
+
+#[test]
+fn unavailable_subject_remains_unavailable_after_retention() {
+    let (owner, source) =
+        NativeSessionSource::start(labels(), NativeSourcePlacement::ContextUnavailable).unwrap();
+    let subject = source.subject();
+    drop(owner);
+    assert_eq!(subject.context(), Err(NativeContextError::Unavailable));
+}
+
+#[test]
+fn foreign_source_ancestor_is_not_a_parent_even_if_phase_is_live() {
+    let (_owner, source) = NativeSessionSource::birth_root(labels()).unwrap();
+    let id = source.actor_context().unwrap().actor();
+    let parent = NativeParent {
+        actor: Arc::new(Actor {
+            id,
+            context: Some(source.actor_context().unwrap()),
+            phase: AtomicU8::new(LIVE),
+            parent: None,
+            process: std::process::id().wrapping_add(1),
+        }),
+    };
+    assert!(matches!(
+        NativeSessionSource::birth_child(labels(), &parent),
+        Err(NativeContextError::ForeignSource)
+    ));
+}
