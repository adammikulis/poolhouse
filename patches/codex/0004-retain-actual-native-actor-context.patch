diff --git a/codex-rs/hooks/src/native_actor.rs b/codex-rs/hooks/src/native_actor.rs
new file mode 100644
index 0000000..24641eb
--- /dev/null
+++ b/codex-rs/hooks/src/native_actor.rs
@@ -0,0 +1,268 @@
+//! Retained source actor lifetime DATA. No constructor authenticates an OS/Node caller.
+use std::fmt;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+use crate::{NativeOccurrenceId, NativeSessionContext};
+
+// Birth and Closing share one process-local linearization gate. Never hold it across I/O/await.
+static GRAPH: Mutex<()> = Mutex::new(());
+const LIVE: u8 = 0;
+const CLOSING: u8 = 1;
+const RETIRED: u8 = 2;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeContextError {
+    ForeignSource,
+    ClosingAncestor,
+    Poisoned,
+    Unavailable,
+}
+impl fmt::Display for NativeContextError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "native actor context unavailable: {self:?}")
+    }
+}
+impl std::error::Error for NativeContextError {}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeActorContext {
+    actor: NativeOccurrenceId,
+    root: NativeOccurrenceId,
+    parent: Option<NativeOccurrenceId>,
+    labels: NativeSessionContext,
+}
+impl NativeActorContext {
+    pub fn actor(&self) -> NativeOccurrenceId {
+        self.actor
+    }
+    pub fn root(&self) -> NativeOccurrenceId {
+        self.root
+    }
+    pub fn direct_parent(&self) -> Option<NativeOccurrenceId> {
+        self.parent
+    }
+    /// Upstream labels are immutable diagnostics, never native ancestry or admission proof.
+    pub fn history_labels(&self) -> NativeSessionContext {
+        self.labels
+    }
+    pub fn canonical_bytes(&self) -> Vec<u8> {
+        let mut bytes = b"CDXCTX01".to_vec();
+        bytes.extend(self.actor.canonical_event_id());
+        bytes.extend(self.root.canonical_event_id());
+        bytes.push(u8::from(self.parent.is_some()));
+        if let Some(parent) = self.parent {
+            bytes.extend(parent.canonical_event_id());
+        }
+        fn label(value: codex_protocol::ThreadId) -> [u8; 16] {
+            *uuid::Uuid::parse_str(&value.to_string())
+                .expect("ThreadId has UUID representation")
+                .as_bytes()
+        }
+        bytes.extend(label(self.labels.actor()));
+        bytes.extend(label(self.labels.root()));
+        bytes.push(u8::from(self.labels.direct_parent().is_some()));
+        if let Some(parent) = self.labels.direct_parent() {
+            bytes.extend(label(parent));
+        }
+        bytes
+    }
+}
+
+#[derive(Debug)]
+pub(super) struct Actor {
+    id: NativeOccurrenceId,
+    context: Option<NativeActorContext>,
+    phase: AtomicU8,
+    parent: Option<Arc<Actor>>,
+    process: u32,
+}
+/// A clone retains immutable ancestry, never the unique owner's live phase.
+#[derive(Clone, Debug)]
+pub struct NativeParent {
+    actor: Arc<Actor>,
+}
+impl NativeParent {
+    pub fn context(&self) -> NativeActorContext {
+        self.actor
+            .context
+            .expect("NativeParent requires resolved source context")
+    }
+    pub fn same_actor(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.actor, &other.actor)
+    }
+    pub fn is_live(&self) -> bool {
+        if !self.actor.current_source() {
+            return false;
+        }
+        let Ok(_gate) = GRAPH.lock() else {
+            return false;
+        };
+        self.actor.live_ancestry(self.actor.id).is_ok()
+    }
+}
+
+/// Retained exactly once by Session. Parent/task references cannot clone or extend this owner.
+#[derive(Debug)]
+pub struct NativeActorOwner {
+    actor: Arc<Actor>,
+}
+impl NativeActorOwner {
+    pub fn begin_closing(&self) -> Result<(), NativeContextError> {
+        if !self.actor.current_source() {
+            return Err(NativeContextError::ForeignSource);
+        }
+        let _gate = GRAPH.lock().map_err(|_| NativeContextError::Poisoned)?;
+        if self.actor.phase.load(Ordering::Relaxed) == LIVE {
+            self.actor.phase.store(CLOSING, Ordering::Relaxed);
+        }
+        Ok(())
+    }
+    pub fn retire(&self) {
+        // A fork must never wait on an inherited graph lock or mutate source ownership.
+        if !self.actor.current_source() {
+            return;
+        }
+        match GRAPH.lock() {
+            Ok(_gate) => self.actor.phase.store(RETIRED, Ordering::Relaxed),
+            Err(_) => self.actor.phase.store(RETIRED, Ordering::Relaxed),
+        }
+    }
+}
+impl Drop for NativeActorOwner {
+    fn drop(&mut self) {
+        self.retire();
+    }
+}
+
+impl Actor {
+    fn current_source(&self) -> bool {
+        self.process == std::process::id() && self.id.belongs_to_current_source()
+    }
+    fn live_ancestry(&self, birth: NativeOccurrenceId) -> Result<(), NativeContextError> {
+        let mut current = Some(self);
+        while let Some(actor) = current {
+            if !actor.current_source() || actor.id.source_uuid_bytes() != birth.source_uuid_bytes()
+            {
+                return Err(NativeContextError::ForeignSource);
+            }
+            if actor.context.is_none() {
+                return Err(NativeContextError::Unavailable);
+            }
+            if actor.phase.load(Ordering::Relaxed) != LIVE {
+                return Err(NativeContextError::ClosingAncestor);
+            }
+            current = actor.parent.as_deref();
+        }
+        Ok(())
+    }
+    pub(super) fn birth(
+        id: NativeOccurrenceId,
+        labels: NativeSessionContext,
+        parent: Option<&NativeParent>,
+    ) -> Result<(NativeActorOwner, Arc<Self>), NativeContextError> {
+        Self::birth_with(id, labels, parent, || {})
+    }
+    // Private observation hook lets pure tests pause the REAL critical section; no public callback.
+    fn birth_with(
+        id: NativeOccurrenceId,
+        labels: NativeSessionContext,
+        parent: Option<&NativeParent>,
+        observed: impl FnOnce(),
+    ) -> Result<(NativeActorOwner, Arc<Self>), NativeContextError> {
+        if !id.belongs_to_current_source() {
+            return Err(NativeContextError::ForeignSource);
+        }
+        let _gate = GRAPH.lock().map_err(|_| NativeContextError::Poisoned)?;
+        if let Some(parent) = parent {
+            parent.actor.live_ancestry(id)?;
+        }
+        observed();
+        let context = NativeActorContext {
+            actor: id,
+            root: parent.map_or(id, |parent| parent.context().root),
+            parent: parent.map(|parent| parent.context().actor),
+            labels,
+        };
+        let actor = Arc::new(Self {
+            id,
+            context: Some(context),
+            phase: AtomicU8::new(LIVE),
+            parent: parent.map(|parent| Arc::clone(&parent.actor)),
+            process: std::process::id(),
+        });
+        Ok((
+            NativeActorOwner {
+                actor: Arc::clone(&actor),
+            },
+            actor,
+        ))
+    }
+    pub(super) fn context(&self) -> Result<NativeActorContext, NativeContextError> {
+        self.context.ok_or(NativeContextError::Unavailable)
+    }
+    pub(super) fn parent_reference(self: &Arc<Self>) -> Result<NativeParent, NativeContextError> {
+        self.context()?;
+        Ok(NativeParent {
+            actor: Arc::clone(self),
+        })
+    }
+    pub(super) fn unavailable(
+        id: NativeOccurrenceId,
+    ) -> Result<(NativeActorOwner, Arc<Self>), NativeContextError> {
+        if !id.belongs_to_current_source() {
+            return Err(NativeContextError::ForeignSource);
+        }
+        let _gate = GRAPH.lock().map_err(|_| NativeContextError::Poisoned)?;
+        let actor = Arc::new(Self {
+            id,
+            context: None,
+            phase: AtomicU8::new(LIVE),
+            parent: None,
+            process: std::process::id(),
+        });
+        Ok((
+            NativeActorOwner {
+                actor: Arc::clone(&actor),
+            },
