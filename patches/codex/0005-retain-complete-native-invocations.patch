+            tool_use_id: "original-tool".into(),
+            tool_input: serde_json::json!({"command":"original-command"}),
+        },
+    );
+    let invocation = event.into_invocation(&owner);
+    let weak = Arc::downgrade(&invocation);
+    let dispatch = invocation.dispatch().unwrap();
+    let mut scratch = invocation.request::<crate::PreToolUseRequest>().clone();
+    scratch.turn_id = "different-turn".into();
+    scratch.tool_input = serde_json::json!({"command":"different-command"});
+    drop(invocation);
+    let held = weak
+        .upgrade()
