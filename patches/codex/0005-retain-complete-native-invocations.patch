+    assert_eq!(dispatch.cwd(), original_cwd.as_path());
+    assert_eq!(dispatch.turn_id().as_deref(), Some("original-turn"));
+    let rendered: serde_json::Value = serde_json::from_str(dispatch.input()).unwrap();
+    assert_eq!(rendered["turn_id"], "original-turn");
+    assert_eq!(rendered["tool_input"]["command"], "original-command");
+    assert!(rendered.get("matcher_aliases").is_none());
+    drop(held);
+    drop(dispatch);
+    assert!(
+        weak.upgrade().is_none(),
