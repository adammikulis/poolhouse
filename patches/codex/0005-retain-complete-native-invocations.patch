+                    thread_id: owner.context().actor(),
+                    turn_id: "original-legacy-turn".into(),
+                    input_messages: vec!["original-full-input".into()],
+                    last_assistant_message: None,
+                },
+            },
+        },
+    );
+    let invocation = event.into_invocation(&owner);
+    let weak = Arc::downgrade(&invocation);
+    let entered = Arc::new(tokio::sync::Notify::new());
+    let release = Arc::new(tokio::sync::Notify::new());
+    let notify = entered.clone();
+    let gate = release.clone();
+    let hook = crate::Hook {
+        name: "retention-plumbing".into(),
+        func: Arc::new(move |original| {
+            let notify = notify.clone();
+            let gate = gate.clone();
+            Box::pin(async move {
+                assert_eq!(
+                    original.request::<crate::HookPayload>().client.as_deref(),
+                    Some("original-client")
