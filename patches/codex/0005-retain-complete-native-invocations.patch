+/// Closed, owned source data. Constructing data does not issue an occurrence or grant authority.
+#[doc(hidden)]
+pub struct NativeRequestBody {
+    request: NativeRequest,
+}
+impl NativeRequestBody {
+    fn kind(&self) -> NativeHookKind {
+        self.request.kind()
+    }
+}
+pub(crate) enum NativeRequest {
+    PreToolUse(crate::PreToolUseRequest),
+    PermissionRequest(crate::PermissionRequestRequest),
+    PostToolUse(crate::PostToolUseRequest),
+    PreCompact(crate::PreCompactRequest),
+    PostCompact(crate::PostCompactRequest),
+    UserPromptSubmit(crate::UserPromptSubmitRequest),
+    SessionEnd(crate::SessionEndRequest),
+    Interrupt(crate::InterruptRequest),
+    SessionStart(crate::SessionStartRequest),
+    Stop(crate::StopRequest),
+    ModelRequest(crate::ModelRequestHookInput),
+    Legacy(crate::HookPayload),
+    #[cfg(test)]
+    Test(tests::TestRequest),
+}
+impl NativeRequest {
+    fn kind(&self) -> NativeHookKind {
+        match self {
+            Self::PreToolUse(r) => r.native_kind(),
+            Self::PermissionRequest(r) => r.native_kind(),
+            Self::PostToolUse(r) => r.native_kind(),
+            Self::PreCompact(r) => r.native_kind(),
+            Self::PostCompact(r) => r.native_kind(),
+            Self::UserPromptSubmit(r) => r.native_kind(),
+            Self::SessionEnd(r) => r.native_kind(),
+            Self::Interrupt(r) => r.native_kind(),
+            Self::SessionStart(r) => r.native_kind(),
+            Self::Stop(r) => r.native_kind(),
+            Self::ModelRequest(r) => r.native_kind(),
+            Self::Legacy(r) => r.native_kind(),
+            #[cfg(test)]
+            Self::Test(r) => r.native_kind(),
+        }
+    }
+}
