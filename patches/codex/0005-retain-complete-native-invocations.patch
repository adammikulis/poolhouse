+                    input_messages: vec!["complete-input".into()],
+                    last_assistant_message: None,
+                },
+            },
+        },
+    );
+    let original = event.retained();
+    let command = format!(
+        "touch '{}'; while [ ! -f '{}' ]; do /bin/sleep 0.01; done",
+        dir.path().join("started").display(),
+        dir.path().join("release").display()
+    );
+    let hook = crate::legacy_notify::notify_hook(
+        vec!["/bin/sh".into(), "-c".into(), command],
+        Arc::new(Vec::new()),
