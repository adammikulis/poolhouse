@@ -0,0 +1,208 @@
+//! Private finite projections, retained with their complete immutable native source request.
+use crate::NativeInvocation;
+use crate::events::{compact, permission_request, post_tool_use, pre_tool_use};
+use crate::native_occurrence::NativeRequest;
+use crate::schema::*;
+use serde_json::{Map, Value};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+pub(crate) struct NativeDispatch {
+    invocation: Arc<NativeInvocation>,
+    input: String,
+    cwd: PathBuf,
+    turn_id: Option<String>,
+    metadata: Option<Map<String, Value>>,
+}
+impl NativeDispatch {
+    pub(crate) fn invocation(&self) -> &Arc<NativeInvocation> {
+        &self.invocation
+    }
+    pub(crate) fn input(&self) -> &str {
+        &self.input
+    }
+    pub(crate) fn cwd(&self) -> &Path {
+        &self.cwd
+    }
+    pub(crate) fn turn_id(&self) -> Option<String> {
+        self.turn_id.clone()
+    }
+    pub(crate) fn metadata(&self) -> Option<&Map<String, Value>> {
+        self.metadata.as_ref()
+    }
+    pub(super) fn capture(
+        invocation: Arc<NativeInvocation>,
+    ) -> Result<Arc<Self>, serde_json::Error> {
+        let (input, cwd, turn_id, metadata) = match invocation.original() {
+            NativeRequest::PreToolUse(r) => (
+                pre_tool_use::command_input_json(r)?,
+                r.cwd.to_path_buf(),
+                Some(r.turn_id.clone()),
+                None,
+            ),
+            NativeRequest::PostToolUse(r) => (
+                post_tool_use::command_input_json(r)?,
+                r.cwd.to_path_buf(),
+                Some(r.turn_id.clone()),
+                None,
+            ),
+            NativeRequest::PermissionRequest(r) => (
+                serde_json::to_string(&permission_request::build_command_input(r))?,
+                r.cwd.to_path_buf(),
+                Some(r.turn_id.clone()),
+                None,
+            ),
+            NativeRequest::PreCompact(r) => (
+                compact::pre_command_input_json(r)?,
+                r.cwd.to_path_buf(),
+                Some(r.turn_id.clone()),
+                None,
+            ),
+            NativeRequest::PostCompact(r) => (
+                compact::post_command_input_json(r)?,
+                r.cwd.to_path_buf(),
+                Some(r.turn_id.clone()),
+                None,
+            ),
+            NativeRequest::ModelRequest(r) => (
+                serde_json::to_string(r)?,
+                r.cwd.to_path_buf(),
+                Some(r.turn_id.clone()),
+                None,
+            ),
+            NativeRequest::UserPromptSubmit(r) => {
+                let subagent = SubagentCommandInputFields::from(r.subagent.as_ref());
+                let input = serde_json::to_string(&UserPromptSubmitCommandInput {
+                    session_id: r.session_id.to_string(),
+                    turn_id: r.turn_id.clone(),
+                    agent_id: subagent.agent_id,
+                    agent_type: subagent.agent_type,
+                    transcript_path: NullableString::from_path(r.transcript_path.clone()),
+                    cwd: r.cwd.display().to_string(),
+                    hook_event_name: "UserPromptSubmit".into(),
+                    model: r.model.clone(),
+                    permission_mode: r.permission_mode.clone(),
+                    prompt: r.prompt.clone(),
+                })?;
+                (input, r.cwd.to_path_buf(), Some(r.turn_id.clone()), None)
+            }
+            NativeRequest::SessionEnd(r) => {
+                let input = serde_json::to_string(&SessionEndCommandInput {
+                    session_id: r.session_id.to_string(),
+                    transcript_path: NullableString::from_path(r.transcript_path.clone()),
+                    cwd: r.cwd.display().to_string(),
+                    hook_event_name: "SessionEnd".into(),
+                    reason: "other".into(),
+                })?;
+                (input, r.cwd.to_path_buf(), Some(r.turn_id.clone()), None)
+            }
+            NativeRequest::Interrupt(r) => {
+                let input = serde_json::to_string(&InterruptCommandInput {
+                    session_id: r.session_id.to_string(),
+                    turn_id: r.turn_id.clone(),
+                    transcript_path: NullableString::from_path(r.transcript_path.clone()),
+                    cwd: r.cwd.display().to_string(),
+                    hook_event_name: "Interrupt".into(),
+                    model: r.model.clone(),
+                    permission_mode: r.permission_mode.clone(),
+                })?;
+                (
+                    input,
+                    r.cwd.to_path_buf(),
+                    Some(r.turn_id.clone()),
+                    r.request_metadata.clone(),
+                )
+            }
+            NativeRequest::SessionStart(r) => {
+                let (input, turn) = match &r.target {
+                    crate::StartHookTarget::SessionStart { source } => (
+                        serde_json::to_string(&SessionStartCommandInput::new(
+                            r.session_id.to_string(),
+                            r.transcript_path.clone(),
+                            r.cwd.display().to_string(),
+                            r.model.clone(),
+                            r.permission_mode.clone(),
+                            source.as_str().to_string(),
+                        ))?,
+                        r.turn_id.clone(),
+                    ),
+                    crate::StartHookTarget::SubagentStart {
+                        turn_id,
+                        agent_id,
+                        agent_type,
+                    } => (
+                        serde_json::to_string(&SubagentStartCommandInput {
+                            session_id: r.session_id.to_string(),
+                            turn_id: turn_id.clone(),
+                            transcript_path: NullableString::from_path(r.transcript_path.clone()),
+                            cwd: r.cwd.display().to_string(),
+                            hook_event_name: "SubagentStart".into(),
+                            model: r.model.clone(),
+                            permission_mode: r.permission_mode.clone(),
+                            agent_id: agent_id.clone(),
+                            agent_type: agent_type.clone(),
+                        })?,
+                        Some(turn_id.clone()),
+                    ),
+                };
+                (input, r.cwd.to_path_buf(), turn, None)
+            }
+            NativeRequest::Stop(r) => {
+                let input = match &r.target {
+                    crate::StopHookTarget::Stop | crate::StopHookTarget::MemoryConsolidation => {
+                        serde_json::to_string(&StopCommandInput {
+                            session_id: r.session_id.to_string(),
+                            turn_id: r.turn_id.clone(),
+                            transcript_path: NullableString::from_path(r.transcript_path.clone()),
+                            cwd: r.cwd.display().to_string(),
+                            hook_event_name: "Stop".into(),
+                            model: r.model.clone(),
+                            permission_mode: r.permission_mode.clone(),
+                            stop_hook_active: r.stop_hook_active,
+                            last_assistant_message: NullableString::from_string(
+                                r.last_assistant_message.clone(),
+                            ),
+                        })?
+                    }
+                    crate::StopHookTarget::SubagentStop {
+                        agent_id,
+                        agent_type,
+                        agent_transcript_path,
+                    } => serde_json::to_string(&SubagentStopCommandInput {
+                        session_id: r.session_id.to_string(),
+                        turn_id: r.turn_id.clone(),
+                        transcript_path: NullableString::from_path(r.transcript_path.clone()),
+                        agent_transcript_path: NullableString::from_path(
+                            agent_transcript_path.clone(),
+                        ),
+                        cwd: r.cwd.display().to_string(),
+                        hook_event_name: "SubagentStop".into(),
+                        model: r.model.clone(),
+                        permission_mode: r.permission_mode.clone(),
+                        stop_hook_active: r.stop_hook_active,
+                        agent_id: agent_id.clone(),
+                        agent_type: agent_type.clone(),
+                        last_assistant_message: NullableString::from_string(
+                            r.last_assistant_message.clone(),
+                        ),
+                    })?,
+                };
+                (
+                    input,
+                    r.cwd.to_path_buf(),
+                    Some(r.turn_id.clone()),
+                    r.request_metadata.clone(),
+                )
+            }
+            // Legacy is rendered only by its finite legacy callback, while it retains this invocation.
+            _ => unreachable!("unsupported configured native request projection"),
+        };
+        Ok(Arc::new(Self {
+            invocation,
+            input,
+            cwd,
+            turn_id,
+            metadata,
+        }))
+    }
+}
