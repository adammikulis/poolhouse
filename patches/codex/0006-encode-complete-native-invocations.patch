+        tool_use_id: "id".into(),
+        tool_input: serde_json::json!([[["nested"]]]),
+    });
+    let mut output = [0xaa; 4096];
+    let mut scratch = [Scratch::default()];
+    assert_eq!(
+        invocation
+            .encode_original(&mut output, &mut scratch, 100000)
+            .unwrap_err(),
+        EncodeError::Scratch
+    );
+    assert!(scratch.iter().all(Scratch::is_empty));
+    for bad in ["", "+1", "01", "1.", "1e", "--1", "NaN", "1 2"] {
+        assert!(!valid_number(bad.as_bytes()), "{bad}");
+    }
+}
+
+#[test]
+fn original_encoder_zero_work_refuses_large_opaque_workspace_without_touching_output() {
+    let invocation = original(SessionEndRequest {
+        session_id: ThreadId::new(),
+        turn_id: "turn".into(),
+        cwd: path(),
+        transcript_path: None,
+    });
+    let mut scratch: Vec<_> = (0..65536).map(|_| Scratch::default()).collect();
+    let mut output = [0xaa; 512];
+    for work in [0, 1, 65535] {
+        assert_eq!(
+            invocation
+                .encode_original(&mut output, &mut scratch, work)
+                .unwrap_err(),
+            EncodeError::Work
+        );
+        assert_eq!(output, [0xaa; 512]);
+    }
+    assert!(scratch.iter().all(Scratch::is_empty));
+}
