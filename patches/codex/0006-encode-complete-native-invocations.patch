+/// Only an exact retained source object can export; successful bytes remain UNTRUSTED DATA.
+/// Any error invalidates and zeroes the written prefix and clears all traversal references.
+impl Drop for Encoder<'_, '_, '_> {
+    fn drop(&mut self) {
+        for slot in self.scratch.iter_mut() {
+            slot.0 = None;
+        }
+    }
+}
+fn encode<'o, 'v>(
+    invocation: &'v Arc<NativeInvocation>,
+    output: &'o mut [u8],
+    scratch: &mut [Scratch<'v>],
+    work: u64,
+) -> Result<&'o [u8], EncodeError> {
+    // Reserve ALL scratch cleanup before touching it. Opaque slots can only be
+    // constructed empty and Drop clears them after every previous active call.
+    // Each output write reserves copy + possible failure-zeroing work up front.
+    let cleanup = u64::try_from(scratch.len()).map_err(|_| EncodeError::Work)?;
+    let work = work.checked_sub(cleanup).ok_or(EncodeError::Work)?;
+    let mut encoder = Encoder {
+        output,
+        at: 0,
+        work,
+        scratch,
+        top: 0,
+    };
+    let result = encoder.invocation(invocation);
+    let written = encoder.at;
+    drop(encoder);
+    match result {
+        Ok(()) => Ok(&output[..written]),
+        Err(error) => {
+            output[..written].fill(0);
+            Err(error)
+        }
+    }
+}
+
+impl NativeInvocation {
+    pub(crate) fn encode_original<'o, 'v>(
+        self: &'v Arc<Self>,
+        output: &'o mut [u8],
+        scratch: &mut [Scratch<'v>],
+        work: u64,
+    ) -> Result<&'o [u8], EncodeError> {
+        encode(self, output, scratch, work)
+    }
+}
