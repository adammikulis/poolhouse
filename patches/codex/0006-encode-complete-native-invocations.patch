index 0000000..3b97ae2
--- /dev/null
+++ b/codex-rs/hooks/src/native_original_message.rs
@@ -0,0 +1,343 @@
+//! Private complete original-request DATA export. No transport, admission or effect rights.
+use crate::NativeInvocation;
+use serde_json::{Map, Value};
+use std::sync::Arc;
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum EncodeError {
+    Buffer,
+    Work,
+    Scratch,
+    Unsupported,
+    Context,
+    Length,
+    Number,
+}
+/// Caller-owned bounded traversal workspace. No values or scratch escape encoding.
+enum Frame<'v> {
+    Value(&'v Value),
+    Array(std::slice::Iter<'v, Value>),
+    Object(serde_json::map::Iter<'v>),
+}
+/// Opaque caller storage: only empty construction is available outside this module.
+/// Encoder Drop clears every slot, including during unwinding.
+#[derive(Default)]
+pub(crate) struct Scratch<'v>(Option<Frame<'v>>);
+impl Scratch<'_> {
+    #[cfg(test)]
+    fn is_empty(&self) -> bool {
+        self.0.is_none()
+    }
+}
+struct Encoder<'o, 's, 'v> {
+    output: &'o mut [u8],
+    at: usize,
+    work: u64,
+    scratch: &'s mut [Scratch<'v>],
+    top: usize,
+}
+impl<'o, 's, 'v> Encoder<'o, 's, 'v> {
+    fn charge(&mut self, count: usize) -> Result<(), EncodeError> {
+        self.work = self
+            .work
+            .checked_sub(u64::try_from(count).map_err(|_| EncodeError::Work)?)
+            .ok_or(EncodeError::Work)?;
+        Ok(())
+    }
+    fn put(&mut self, bytes: &[u8]) -> Result<(), EncodeError> {
+        self.charge(bytes.len().checked_mul(2).ok_or(EncodeError::Work)?)?;
+        let end = self
+            .at
+            .checked_add(bytes.len())
+            .ok_or(EncodeError::Length)?;
+        self.output
+            .get_mut(self.at..end)
+            .ok_or(EncodeError::Buffer)?
+            .copy_from_slice(bytes);
+        self.at = end;
+        Ok(())
+    }
+    fn tag(&mut self, value: u16) -> Result<(), EncodeError> {
+        self.put(&value.to_be_bytes())
+    }
+    fn count(&mut self, value: usize) -> Result<(), EncodeError> {
+        self.put(
+            &u64::try_from(value)
+                .map_err(|_| EncodeError::Length)?
+                .to_be_bytes(),
+        )
+    }
+    fn flag(&mut self, value: bool) -> Result<(), EncodeError> {
+        self.put(&[u8::from(value)])
+    }
+    fn bytes(&mut self, value: &[u8]) -> Result<(), EncodeError> {
+        self.count(value.len())?;
+        self.put(value)
+    }
+    fn string(&mut self, value: &str) -> Result<(), EncodeError> {
+        self.bytes(value.as_bytes())
+    }
+    fn uuid(&mut self, value: &codex_protocol::ThreadId) -> Result<(), EncodeError> {
+        use std::fmt::Write;
+        struct Stack {
+            bytes: [u8; 36],
+            at: usize,
+        }
+        impl std::fmt::Write for Stack {
+            fn write_str(&mut self, value: &str) -> std::fmt::Result {
+                let end = self.at.checked_add(value.len()).ok_or(std::fmt::Error)?;
+                self.bytes
+                    .get_mut(self.at..end)
+                    .ok_or(std::fmt::Error)?
+                    .copy_from_slice(value.as_bytes());
+                self.at = end;
+                Ok(())
+            }
+        }
+        self.charge(36)?;
+        let mut text = Stack {
+            bytes: [0; 36],
+            at: 0,
+        };
+        write!(&mut text, "{value}").map_err(|_| EncodeError::Unsupported)?;
+        let text =
+            std::str::from_utf8(&text.bytes[..text.at]).map_err(|_| EncodeError::Unsupported)?;
+        let id = uuid::Uuid::parse_str(text).map_err(|_| EncodeError::Unsupported)?;
+        self.put(id.as_bytes())
+    }
+    fn path(&mut self, value: &std::path::Path) -> Result<(), EncodeError> {
+        #[cfg(unix)]
+        {
+            use std::os::unix::ffi::OsStrExt;
+            self.put(&[1])?;
+            self.bytes(value.as_os_str().as_bytes())
+        }
+        #[cfg(windows)]
+        {
+            use std::os::windows::ffi::OsStrExt;
+            self.put(&[2])?;
+            let mut count = 0usize;
+            for _ in value.as_os_str().encode_wide() {
+                self.charge(1)?;
+                count = count.checked_add(1).ok_or(EncodeError::Length)?;
+            }
+            self.count(count)?;
+            for unit in value.as_os_str().encode_wide() {
+                self.put(&unit.to_be_bytes())?;
+            }
+            Ok(())
+        }
+        #[cfg(not(any(unix, windows)))]
+        {
+            let _ = value;
+            Err(EncodeError::Unsupported)
+        }
+    }
+    fn timestamp(&mut self, value: &chrono::DateTime<chrono::Utc>) -> Result<(), EncodeError> {
+        self.put(&value.timestamp().to_be_bytes())?;
+        self.put(&value.timestamp_subsec_nanos().to_be_bytes())
+    }
+    fn number(&mut self, value: &serde_json::Number) -> Result<(), EncodeError> {
+        // arbitrary_precision retains the observed token; never format, round or allocate.
+        let token = value.as_str().as_bytes();
+        self.charge(
+            token
+                .len()
+                .checked_mul(4)
+                .and_then(|n| n.checked_add(16))
+                .ok_or(EncodeError::Work)?,
+        )?;
+        if !valid_number(token) {
+            return Err(EncodeError::Number);
+        }
+        self.bytes(token)
+    }
+    fn push(&mut self, frame: Frame<'v>) -> Result<(), EncodeError> {
+        self.charge(1)?;
+        *self.scratch.get_mut(self.top).ok_or(EncodeError::Scratch)? = Scratch(Some(frame));
+        self.top = self.top.checked_add(1).ok_or(EncodeError::Length)?;
+        Ok(())
+    }
+    fn value_map(&mut self, value: &'v Map<String, Value>) -> Result<(), EncodeError> {
+        self.count(value.len())?;
+        self.push(Frame::Object(value.iter()))?;
+        self.walk()
+    }
+    fn value(&mut self, value: &'v Value) -> Result<(), EncodeError> {
+        self.push(Frame::Value(value))?;
+        self.walk()
+    }
+    fn walk(&mut self) -> Result<(), EncodeError> {
+        while self.top != 0 {
+            self.charge(1)?;
+            self.top -= 1;
+            match self.scratch[self.top]
+                .0
+                .take()
+                .ok_or(EncodeError::Scratch)?
+            {
+                Frame::Value(value) => {
+                    self.tag(value_tag(value))?;
+                    match value {
+                        Value::Null => (),
+                        Value::Bool(value) => {
+                            self.flag(*value)?;
+                        }
+                        Value::String(value) => {
+                            self.string(value)?;
+                        }
+                        Value::Number(value) => {
+                            self.number(value)?;
+                        }
+                        Value::Array(values) => {
+                            self.count(values.len())?;
+                            self.push(Frame::Array(values.iter()))?;
+                        }
+                        Value::Object(values) => {
+                            self.count(values.len())?;
+                            self.push(Frame::Object(values.iter()))?;
+                        }
+                    }
+                }
+                Frame::Array(mut values) => {
+                    if let Some(value) = values.next() {
+                        self.push(Frame::Array(values))?;
+                        self.push(Frame::Value(value))?;
+                    }
+                }
+                Frame::Object(mut values) => {
+                    if let Some((key, value)) = values.next() {
+                        self.string(key)?;
+                        self.push(Frame::Object(values))?;
+                        self.push(Frame::Value(value))?;
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+    fn context(&mut self, context: crate::NativeActorContext) -> Result<(), EncodeError> {
+        let labels = context.history_labels();
+        let count = 106usize
+            .checked_add(if context.direct_parent().is_some() {
+                32
+            } else {
+                0
+            })
+            .and_then(|n| {
+                n.checked_add(if labels.direct_parent().is_some() {
+                    16
+                } else {
+                    0
+                })
+            })
+            .ok_or(EncodeError::Length)?;
+        self.count(count)?;
+        self.put(b"CDXCTX01")?;
+        self.put(&context.actor().canonical_event_id())?;
+        self.put(&context.root().canonical_event_id())?;
+        self.flag(context.direct_parent().is_some())?;
+        if let Some(parent) = context.direct_parent() {
+            self.put(&parent.canonical_event_id())?;
+        }
+        self.uuid(&labels.actor())?;
+        self.uuid(&labels.root())?;
+        self.flag(labels.direct_parent().is_some())?;
+        if let Some(parent) = labels.direct_parent() {
+            self.uuid(&parent)?;
+        }
+        Ok(())
+    }
+}
+// Exact JSON number syntax, observed token preserved. No floating conversion.
+fn valid_number(bytes: &[u8]) -> bool {
+    fn digits(bytes: &[u8], at: &mut usize) -> bool {
+        let start = *at;
+        while bytes.get(*at).is_some_and(u8::is_ascii_digit) {
+            *at += 1;
+        }
+        *at != start
+    }
+    fn eat(bytes: &[u8], at: &mut usize, value: u8) -> bool {
+        if bytes.get(*at) == Some(&value) {
+            *at += 1;
+            true
+        } else {
+            false
+        }
+    }
+    let mut at = 0;
+    eat(bytes, &mut at, b'-');
+    if eat(bytes, &mut at, b'0') {
+        if bytes.get(at).is_some_and(u8::is_ascii_digit) {
+            return false;
+        }
+    } else if !digits(bytes, &mut at) {
+        return false;
+    }
+    if eat(bytes, &mut at, b'.') && !digits(bytes, &mut at) {
+        return false;
+    }
+    if eat(bytes, &mut at, b'e') || eat(bytes, &mut at, b'E') {
+        if !eat(bytes, &mut at, b'+') {
+            eat(bytes, &mut at, b'-');
+        }
+        if !digits(bytes, &mut at) {
+            return false;
+        }
+    }
+    at == bytes.len()
+}
