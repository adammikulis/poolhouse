+#[test]
+fn source_configuration_legacy_owner_is_independent_of_engine_overlay() {
+    let id = ThreadId::new();
+    let (_owner, source) =
+        NativeSessionSource::birth_root(NativeSessionContext::new(id, id, None)).unwrap();
+    let (hooks, _results) = crate::Hooks::new(
+        crate::HooksConfig::default(),
+        source.clone(),
+        Arc::new(UnusedExecutor),
+    )
+    .unwrap();
+    let legacy = |hooks: &crate::Hooks| {
+        let request = crate::HookPayload {
+            session_id: id,
+            cwd: cwd(),
+            client: None,
+            triggered_at: chrono::Utc::now(),
+            hook_event: crate::HookEvent::AfterAgent {
+                event: crate::HookEventAfterAgent {
+                    thread_id: id,
+                    turn_id: "turn".into(),
+                    input_messages: vec![],
+                    last_assistant_message: None,
+                },
+            },
+        };
+        NativeEvent::capture(source.clone(), request)
+            .into_invocation(&source)
+            .legacy_selection(hooks)
+            .configuration_observation()
+    };
+    let original_id = legacy(&hooks);
+    assert_eq!(original_id, legacy(&hooks.clone()));
+    let overlay = hooks.for_memory_consolidation(vec![]);
+    assert_eq!(original_id, legacy(&overlay));
+    let reconfigured = hooks.reconfigured(crate::HooksConfig::default());
+    assert_ne!(original_id, legacy(&reconfigured));
+    assert_eq!(
+        original_id.actor_bytes(),
+        source.lifecycle().id().canonical_event_id()
+    );
+}
