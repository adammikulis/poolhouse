+    assert_eq!(&observed.canonical_bytes()[..16], &original_bytes[..16]);
+    assert!(
+        u64::from_be_bytes(observed.canonical_bytes()[16..24].try_into().unwrap())
+            > u64::from_be_bytes(original_bytes[16..24].try_into().unwrap()),
+        "first selection may observe a config created after request capture"
