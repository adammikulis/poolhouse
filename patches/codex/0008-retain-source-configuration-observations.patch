+//! Actual configuration-owner snapshot observations. DATA only, never Node generation or rights.
+use crate::engine::{ConfiguredHandler, command_runner::CommandHookRuntime};
+use crate::mcp::HookMcpExecutor;
+use crate::{Hook, NativeOccurrenceId, NativeSessionSource};
+use std::sync::Arc;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct SourceConfigurationSnapshotObservationId {
+    id: NativeOccurrenceId,
+    actor: NativeOccurrenceId,
+}
+impl SourceConfigurationSnapshotObservationId {
+    fn capture(source: &NativeSessionSource) -> Self {
+        Self {
+            id: crate::native_occurrence::next_id(),
+            actor: source.lifecycle().id(),
+        }
+    }
+    pub(crate) fn canonical_bytes(&self) -> [u8; 32] {
+        self.id.canonical_event_id()
+    }
+    pub(crate) fn actor_bytes(&self) -> [u8; 32] {
+        self.actor.canonical_event_id()
+    }
+}
+/// Only immutable access is exposed. Every changed view constructs a new owner.
+pub(crate) struct ConfigurationSnapshot {
+    observation: SourceConfigurationSnapshotObservationId,
+    handlers: Arc<Vec<ConfiguredHandler>>,
+    runtime: CommandHookRuntime,
+    executor: Arc<dyn HookMcpExecutor>,
+}
+impl ConfigurationSnapshot {
+    pub(crate) fn new(
+        handlers: Arc<Vec<ConfiguredHandler>>,
+        runtime: CommandHookRuntime,
+        executor: Arc<dyn HookMcpExecutor>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            observation: SourceConfigurationSnapshotObservationId::capture(
+                &runtime.native_source(),
+            ),
+            handlers,
+            runtime,
+            executor,
+        })
+    }
+    pub(crate) fn with_handlers(&self, handlers: Arc<Vec<ConfiguredHandler>>) -> Arc<Self> {
+        Self::new(handlers, self.runtime.clone(), self.executor.clone())
+    }
+    #[cfg(test)]
+    pub(crate) fn with_executor(&self, executor: Arc<dyn HookMcpExecutor>) -> Arc<Self> {
+        Self::new(self.handlers.clone(), self.runtime.clone(), executor)
+    }
+    pub(crate) fn observation(&self) -> SourceConfigurationSnapshotObservationId {
+        self.observation
+    }
+    pub(crate) fn handlers(&self) -> &Arc<Vec<ConfiguredHandler>> {
+        &self.handlers
+    }
+    pub(crate) fn runtime(&self) -> &CommandHookRuntime {
+        &self.runtime
+    }
+    pub(crate) fn executor(&self) -> &Arc<dyn HookMcpExecutor> {
+        &self.executor
+    }
+}
+/// Legacy lists own their own ID; an executor-only overlay does not change this list.
+pub(crate) struct LegacyConfigurationSnapshot {
+    observation: SourceConfigurationSnapshotObservationId,
+    hooks: Arc<[Hook]>,
+    _notify: Option<Arc<crate::legacy_notify::NotifySnapshot>>,
+}
+impl LegacyConfigurationSnapshot {
+    pub(crate) fn new(
+        source: &NativeSessionSource,
+        hooks: Arc<[Hook]>,
+        notify: Option<Arc<crate::legacy_notify::NotifySnapshot>>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            observation: SourceConfigurationSnapshotObservationId::capture(source),
+            hooks,
+            _notify: notify,
+        })
+    }
+    pub(crate) fn observation(&self) -> SourceConfigurationSnapshotObservationId {
+        self.observation
+    }
+    pub(crate) fn hooks(&self) -> &Arc<[Hook]> {
+        &self.hooks
+    }
+    #[cfg(test)]
+    pub(crate) fn notify(&self) -> Option<&Arc<crate::legacy_notify::NotifySnapshot>> {
+        self._notify.as_ref()
+    }
+}
