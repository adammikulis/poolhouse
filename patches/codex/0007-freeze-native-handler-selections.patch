diff --git a/codex-rs/hooks/src/engine/mod_tests.rs b/codex-rs/hooks/src/engine/mod_tests.rs
index 162e216..16a7c29 100644
--- a/codex-rs/hooks/src/engine/mod_tests.rs
+++ b/codex-rs/hooks/src/engine/mod_tests.rs
@@ -3041,3 +3041,93 @@ async fn native_occurrence_stop_two_dispatches_and_executor_retain_original_arc(
     assert_eq!(seen.iter().filter(|(stage, _)| *stage == "mcp").count(), 2);
     assert!(seen.iter().all(|(_, pointer)| *pointer == identity));
 }
+
+#[tokio::test]
+async fn native_selection_retry_uses_original_handler_and_executor_after_reload() {
+    let first_calls = Arc::new(Mutex::new(Vec::new()));
+    let second_calls = Arc::new(Mutex::new(Vec::new()));
+    let executor = |calls| {
+        Arc::new(StaticMcpExecutor {
+            calls,
+            output: String::new(),
+            outputs_by_tool: HashMap::new(),
+        }) as Arc<dyn HookMcpExecutor>
+    };
+    let mut engine = ClaudeHooksEngine::new(
+        true,
+        false,
+        None,
+        Vec::new(),
+        Vec::new(),
+        command_runtime(CommandShell {
+            program: String::new(),
+            args: Vec::new(),
+        }),
+        executor(first_calls.clone()),
+    );
+    engine.handlers = Arc::new(vec![ConfiguredHandler {
+        builtin: false,
+        plugin_trust: None,
+        event_name: HookEventName::PreToolUse,
+        matcher: None,
+        timeout_sec: 5,
+        status_message: None,
+        additional_context_limit: Default::default(),
+        source_path: cwd().join("hooks.json").into(),
+        source: HookSource::User,
+        display_order: 0,
+        kind: ConfiguredHandlerKind::McpTool {
+            server: "plumbing".into(),
+            tool: "first".into(),
+            input: serde_json::Map::new(),
+        },
+    }]);
+    let event = engine.capture_native_event(PreToolUseRequest {
+        session_id: ThreadId::new(),
+        turn_id: "turn".into(),
+        subagent: None,
+        cwd: cwd(),
+        transcript_path: None,
+        model: "model-label".into(),
+        permission_mode: "permission".into(),
+        tool_name: "tool".into(),
+        matcher_aliases: Vec::new(),
+        tool_use_id: "id".into(),
+        tool_input: serde_json::json!({}),
+    });
+    engine.run_pre_tool_use(event.clone()).await;
+    let mut changed = engine.clone();
+    changed.mcp_executor = executor(second_calls.clone());
+    let ConfiguredHandlerKind::McpTool { tool, .. } =
+        &mut Arc::make_mut(&mut changed.handlers)[0].kind
+    else {
+        unreachable!()
+    };
+    *tool = "replacement".into();
+    changed.run_pre_tool_use(event).await;
+    assert_eq!(
+        first_calls.lock().unwrap().len(),
+        2,
+        "same original retries retain first selected executor/config"
+    );
+    assert!(second_calls.lock().unwrap().is_empty());
+    let fresh = changed.capture_native_event(PreToolUseRequest {
+        session_id: ThreadId::new(),
+        turn_id: "fresh".into(),
+        subagent: None,
+        cwd: cwd(),
+        transcript_path: None,
+        model: "model-label".into(),
+        permission_mode: "permission".into(),
+        tool_name: "tool".into(),
+        matcher_aliases: Vec::new(),
+        tool_use_id: "fresh-id".into(),
+        tool_input: serde_json::json!({}),
+    });
+    changed.run_pre_tool_use(fresh).await;
+    assert_eq!(
+        second_calls.lock().unwrap().len(),
+        1,
+        "new originals use refreshed configuration"
+    );
+}
