new file mode 100644
index 0000000..000dc25
--- /dev/null
+++ b/codex-rs/hooks/src/native_manifest.rs
@@ -0,0 +1,142 @@
+//! Frozen actual source selection DATA. No admitted catalog, purpose, measurement or permit.
+use crate::engine::dispatcher;
+use crate::engine::{ClaudeHooksEngine, ConfiguredHandler, HandlerSourcePath};
+use crate::events::common;
+use crate::native_occurrence::NativeRequest;
+use codex_protocol::protocol::HookEventName;
+use std::sync::Arc;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Phase {
+    Regular,
+    MemoryCleanup,
+}
+pub(crate) struct Entry {
+    source_index: usize,
+    phase: Phase,
+}
+/// The engine snapshot keeps the exact immutable configuration allocation and launch
+/// handles. Shared task state and remote MCP internals are NOT frozen or measured.
+pub(crate) struct ConfiguredSelection {
+    engine: ClaudeHooksEngine,
+    entries: Vec<Entry>,
+}
+pub(crate) struct LegacySelection {
+    pub(crate) hooks: Arc<[crate::Hook]>,
+    pub(crate) _notify: Option<Arc<crate::legacy_notify::NotifySnapshot>>,
+}
+pub(crate) enum FrozenSelection {
+    Configured(ConfiguredSelection),
+    Legacy(LegacySelection),
+}
+impl FrozenSelection {
+    pub(crate) fn capture_configured(original: &NativeRequest, engine: &ClaudeHooksEngine) -> Self {
+        let (event, inputs, memory) = match original {
+            NativeRequest::PreToolUse(r) => (
+                HookEventName::PreToolUse,
+                common::matcher_inputs(&r.tool_name, &r.matcher_aliases),
+                false,
+            ),
+            NativeRequest::PermissionRequest(r) => (
+                HookEventName::PermissionRequest,
+                common::matcher_inputs(&r.tool_name, &r.matcher_aliases),
+                false,
+            ),
+            NativeRequest::PostToolUse(r) => (
+                HookEventName::PostToolUse,
+                common::matcher_inputs(&r.tool_name, &r.matcher_aliases),
+                false,
+            ),
+            NativeRequest::PreCompact(r) => {
+                (HookEventName::PreCompact, vec![r.trigger.as_str()], false)
+            }
+            NativeRequest::PostCompact(r) => {
+                (HookEventName::PostCompact, vec![r.trigger.as_str()], false)
+            }
+            NativeRequest::UserPromptSubmit(_) => (HookEventName::UserPromptSubmit, vec![], false),
+            NativeRequest::SessionEnd(_) => (
+                HookEventName::SessionEnd,
+                vec![crate::events::session_end::SESSION_END_REASON],
+                false,
+            ),
+            NativeRequest::Interrupt(_) => (HookEventName::Interrupt, vec![], false),
+            NativeRequest::SessionStart(r) => {
+                (r.target.event_name(), vec![r.target.matcher_input()], false)
+            }
+            NativeRequest::Stop(r) => (
+                r.target.event_name(),
+                r.target.matcher_input().into_iter().collect(),
+                matches!(r.target, crate::StopHookTarget::MemoryConsolidation),
+            ),
+            NativeRequest::ModelRequest(r) => (r.event.hook_event(), vec![], false),
+            NativeRequest::Legacy(_) => {
+                unreachable!("legacy source selection uses the legacy registry")
+            }
+            #[cfg(test)]
+            NativeRequest::Test(_) => unreachable!("identity fixture has no configured selection"),
+        };
+        let entries = dispatcher::select_handler_indices(&engine.handlers, event, &inputs)
+            .into_iter()
+            .filter(|index| !memory || engine.handlers[*index].runs_for_memory_consolidation())
+            .map(|source_index| Entry {
+                source_index,
+                phase: if memory
+                    && matches!(
+                        engine.handlers[source_index].source_path,
+                        HandlerSourcePath::ExecutorScoped { .. }
+                    ) {
+                    Phase::MemoryCleanup
+                } else {
+                    Phase::Regular
+                },
+            })
+            .collect();
+        Self::Configured(ConfiguredSelection {
+            engine: engine.clone(),
+            entries,
+        })
+    }
+    pub(crate) fn capture_legacy(original: &NativeRequest, hooks: &crate::Hooks) -> Self {
+        match original {
+            NativeRequest::Legacy(_) => Self::Legacy(hooks.capture_legacy_selection()),
+            _ => unreachable!("configured source cannot select legacy callbacks"),
+        }
+    }
+    pub(crate) fn configured(&self) -> &ConfiguredSelection {
+        match self {
+            Self::Configured(value) => value,
+            _ => unreachable!("configured selection kind"),
+        }
+    }
+    pub(crate) fn legacy(&self) -> &LegacySelection {
+        match self {
+            Self::Legacy(value) => value,
+            _ => unreachable!("legacy selection kind"),
+        }
+    }
+}
+impl ConfiguredSelection {
+    pub(crate) fn engine(&self) -> &ClaudeHooksEngine {
+        &self.engine
+    }
+    pub(crate) fn ordinals(&self, phase: Phase) -> impl Iterator<Item = usize> + '_ {
+        self.entries
+            .iter()
+            .enumerate()
+            .filter_map(move |(ordinal, entry)| (entry.phase == phase).then_some(ordinal))
+    }
+    pub(crate) fn handler(&self, ordinal: usize) -> &ConfiguredHandler {
+        &self.engine.handlers[self.entries[ordinal].source_index]
+    }
+    pub(crate) fn handlers(&self, phase: Phase) -> Vec<ConfiguredHandler> {
+        self.ordinals(phase)
+            .map(|ordinal| self.handler(ordinal).clone())
+            .collect()
+    }
+    #[cfg(test)]
+    pub(crate) fn source_index(&self, ordinal: usize) -> usize {
+        self.entries[ordinal].source_index
+    }
+}
+#[cfg(test)]
+mod tests;
