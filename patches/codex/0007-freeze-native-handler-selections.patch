@@ -0,0 +1,282 @@
+//! Source observations and plumbing only, never a model, admitted catalog or issuer.
+use super::*;
+use crate::engine::command_runner::CommandHookRuntime;
+use crate::engine::{CommandShell, ConfiguredHandlerKind, HandlerSourcePath};
+use crate::mcp::{HookMcpCall, HookMcpExecutor, HookMcpOutput};
+use crate::{
+    NativeActorOwner, NativeEvent, NativeHookRequest, NativeInvocation, NativeSessionContext,
+    NativeSessionSource,
+};
+use codex_protocol::{ThreadId, protocol::HookSource};
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::sync::Barrier;
+struct UnusedExecutor;
+impl HookMcpExecutor for UnusedExecutor {
+    fn execute(
+        &self,
+        _call: HookMcpCall,
+    ) -> futures::future::BoxFuture<'_, anyhow::Result<HookMcpOutput>> {
+        Box::pin(async { panic!("selection-only fixture cannot execute a tool") })
+    }
+}
+fn cwd() -> AbsolutePathBuf {
+    AbsolutePathBuf::try_from(std::path::PathBuf::from("/tmp/native-selection")).unwrap()
+}
+fn engine() -> (NativeActorOwner, ClaudeHooksEngine) {
+    let id = ThreadId::new();
+    let (owner, source) =
+        NativeSessionSource::birth_root(NativeSessionContext::new(id, id, None)).unwrap();
+    let (sender, _receiver) = async_channel::unbounded();
+    let runtime = CommandHookRuntime::new(
+        CommandShell {
+            program: String::new(),
+            args: vec![],
+        },
+        Arc::new(vec![]),
+        source,
+        sender,
+    );
+    (
+        owner,
+        ClaudeHooksEngine::new(
+            true,
+            false,
+            None,
+            vec![],
+            vec![],
+            runtime,
+            Arc::new(UnusedExecutor),
+        ),
+    )
+}
+fn handler(tool: &str, event: HookEventName) -> ConfiguredHandler {
+    ConfiguredHandler {
+        builtin: false,
+        plugin_trust: None,
+        event_name: event,
+        matcher: None,
+        timeout_sec: 5,
+        status_message: None,
+        additional_context_limit: Default::default(),
+        source_path: cwd().join("hooks.json").into(),
+        source: HookSource::System,
+        display_order: 0,
+        kind: ConfiguredHandlerKind::McpTool {
+            server: "plumbing".into(),
+            tool: tool.into(),
+            input: serde_json::Map::new(),
+        },
+    }
+}
+fn original<T: NativeHookRequest>(engine: &ClaudeHooksEngine, request: T) -> Arc<NativeInvocation> {
+    let source = engine.command_runtime.native_source();
+    NativeEvent::capture(source.clone(), request).into_invocation(&source)
+}
+fn tool() -> crate::PreToolUseRequest {
+    crate::PreToolUseRequest {
+        session_id: ThreadId::new(),
+        turn_id: "turn".into(),
+        subagent: None,
+        cwd: cwd(),
+        transcript_path: None,
+        model: "model-label".into(),
+        permission_mode: "permission".into(),
+        tool_name: "tool".into(),
+        matcher_aliases: vec![],
+        tool_use_id: "id".into(),
+        tool_input: serde_json::Value::Null,
+    }
+}
+#[test]
+fn native_selection_duplicates_keep_distinct_ordinals_and_config_indices() {
+    let (_owner, mut engine) = engine();
+    let selected = handler("duplicate", HookEventName::PreToolUse);
+    engine.handlers = Arc::new(vec![selected.clone(), selected]);
+    let invocation = original(&engine, tool());
+    let selection = invocation.configured_selection(&engine);
+    let selected = selection.configured();
+    assert_eq!(
+        selected.ordinals(Phase::Regular).collect::<Vec<_>>(),
+        vec![0, 1]
+    );
+    assert_eq!(selected.source_index(0), 0);
+    assert_eq!(selected.source_index(1), 1);
+    assert_eq!(selected.handler(0), selected.handler(1));
+}
+#[test]
+fn native_selection_empty_is_frozen_and_new_original_sees_reload() {
+    let (_owner, mut engine) = engine();
+    let invocation = original(&engine, tool());
+    let first = invocation.configured_selection(&engine);
+    engine.handlers = Arc::new(vec![handler("later", HookEventName::PreToolUse)]);
+    let retry = invocation.configured_selection(&engine);
+    assert!(Arc::ptr_eq(&first, &retry));
+    assert_eq!(retry.configured().ordinals(Phase::Regular).count(), 0);
+    let new = original(&engine, tool()).configured_selection(&engine);
+    assert_eq!(new.configured().ordinals(Phase::Regular).count(), 1);
+}
+#[test]
+fn native_selection_concurrent_reload_uses_one_winner_and_drops_losers() {
+    let (_owner, base) = engine();
+    let invocation = original(&base, tool());
+    let weak = Arc::downgrade(&invocation);
+    let barrier = Arc::new(Barrier::new(8));
+    let mut candidates = vec![];
+    let results = std::thread::scope(|scope| {
+        let mut handles = vec![];
+        for index in 0..8 {
+            let mut candidate = base.clone();
+            candidate.handlers = Arc::new(vec![handler(
+                &format!("candidate-{index}"),
+                HookEventName::PreToolUse,
+            )]);
+            candidates.push(Arc::downgrade(&candidate.handlers));
+            let barrier = barrier.clone();
+            let original = invocation.clone();
+            handles.push(scope.spawn(move || {
+                barrier.wait();
+                original.configured_selection(&candidate)
+            }));
+        }
+        handles
+            .into_iter()
+            .map(|handle| handle.join().unwrap())
+            .collect::<Vec<_>>()
+    });
+    for result in &results {
+        assert!(Arc::ptr_eq(result, &results[0]));
+    }
+    assert_eq!(
+        candidates
+            .iter()
+            .filter(|weak| weak.upgrade().is_some())
+            .count(),
+        1,
+        "only published winner retains configuration"
+    );
+    drop(invocation);
+    assert!(
+        weak.upgrade().is_none(),
+        "selection has no original back-reference"
+    );
+    drop(results);
+    assert!(candidates.iter().all(|weak| weak.upgrade().is_none()));
+}
+#[test]
+fn native_selection_stop_phases_share_one_complete_ordered_catalog() {
+    let (_owner, mut engine) = engine();
+    let regular = handler("managed", HookEventName::Stop);
+    let mut cleanup = handler("cleanup", HookEventName::Stop);
+    cleanup.source_path = HandlerSourcePath::ExecutorScoped {
+        plugin_id: codex_plugin::PluginId::parse("demo@test").unwrap(),
+        environment_id: "executor".into(),
+        mcp_environment_id: None,
+        mcp_metadata: None,
+        manifest_path: "file:///plugins/demo/plugin.json".parse().unwrap(),
+        source_relative_path: "hooks[0]".into(),
+    };
+    let mut excluded = handler("user", HookEventName::Stop);
+    excluded.source = HookSource::User;
+    engine.handlers = Arc::new(vec![regular.clone(), cleanup, excluded, regular]);
+    let request = crate::StopRequest {
+        session_id: ThreadId::new(),
+        turn_id: "turn".into(),
+        cwd: cwd(),
+        transcript_path: None,
+        model: "model-label".into(),
+        permission_mode: "permission".into(),
+        request_metadata: None,
+        stop_hook_active: false,
+        last_assistant_message: None,
+        target: crate::StopHookTarget::MemoryConsolidation,
+    };
+    let invocation = original(&engine, request);
+    let first = invocation.configured_selection(&engine);
+    let dispatch = invocation.dispatch(&engine).unwrap();
+    assert!(std::ptr::eq(first.configured(), dispatch.selection()));
+    assert_eq!(
+        first
+            .configured()
+            .ordinals(Phase::Regular)
+            .collect::<Vec<_>>(),
+        vec![0, 2]
+    );
+    assert_eq!(
+        first
+            .configured()
+            .ordinals(Phase::MemoryCleanup)
+            .collect::<Vec<_>>(),
+        vec![1]
+    );
+    assert_eq!(first.configured().source_index(2), 3);
+    engine.handlers = Arc::new(vec![]);
+    let retry = invocation.configured_selection(&engine);
+    assert!(Arc::ptr_eq(&first, &retry));
+    assert_eq!(
+        retry
+            .configured()
+            .ordinals(Phase::MemoryCleanup)
+            .collect::<Vec<_>>(),
+        vec![1]
+    );
+}
+#[test]
+fn native_selection_dispatch_retains_original_without_a_cycle() {
+    let (_owner, mut engine) = engine();
+    engine.handlers = Arc::new(vec![handler("selected", HookEventName::PreToolUse)]);
+    let invocation = original(&engine, tool());
+    let weak = Arc::downgrade(&invocation);
+    let dispatch = invocation.dispatch(&engine).unwrap();
+    drop(invocation);
+    assert!(weak.upgrade().is_some());
+    drop(dispatch);
+    assert!(weak.upgrade().is_none());
+}
+#[test]
+fn native_selection_legacy_retries_keep_exact_callbacks_and_notify_snapshot() {
+    let id = ThreadId::new();
+    let (_owner, source) =
+        NativeSessionSource::birth_root(NativeSessionContext::new(id, id, None)).unwrap();
+    let (hooks, _receiver) = crate::Hooks::new(
+        crate::HooksConfig {
+            legacy_notify_argv: Some(vec!["first-notify".into()]),
+            ..Default::default()
+        },
+        source.clone(),
+        Arc::new(UnusedExecutor),
+    )
+    .unwrap();
+    let event = hooks.capture_native_event(crate::HookPayload {
+        session_id: id,
+        cwd: cwd(),
+        client: None,
+        triggered_at: chrono::Utc::now(),
+        hook_event: crate::HookEvent::AfterAgent {
+            event: crate::HookEventAfterAgent {
+                thread_id: id,
+                turn_id: "turn".into(),
+                input_messages: vec![],
+                last_assistant_message: None,
+            },
+        },
+    });
+    let invocation = event.into_invocation(&source);
+    let first = invocation.legacy_selection(&hooks);
+    let changed = hooks.reconfigured(crate::HooksConfig {
+        legacy_notify_argv: Some(vec!["replacement-notify".into()]),
+        ..Default::default()
+    });
+    let retry = invocation.legacy_selection(&changed);
+    assert!(Arc::ptr_eq(&first, &retry));
+    assert!(Arc::ptr_eq(
+        &first.legacy().hooks[0].func,
+        &retry.legacy().hooks[0].func
+    ));
+    assert!(Arc::ptr_eq(
+        first.legacy()._notify.as_ref().unwrap(),
+        retry.legacy()._notify.as_ref().unwrap()
+    ));
+    let weak = Arc::downgrade(&invocation);
+    drop(invocation);
+    assert!(weak.upgrade().is_none());
+}
