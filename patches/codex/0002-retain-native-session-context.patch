+#[test]
+fn native_session_context_survives_hook_reconfiguration() {
+    let root = ThreadId::new();
+    let parent = ThreadId::new();
+    let actor = ThreadId::new();
+    let context = crate::NativeSessionContext::new(actor, root, Some(parent));
+    let (hooks, _results) =
+        crate::Hooks::new(crate::HooksConfig::default(), context, mcp_executor())
+            .expect("initialize native hooks");
+    assert_eq!(hooks.native_session_context(), context);
+    let reconfigured = hooks.reconfigured(crate::HooksConfig::default());
+    assert_eq!(reconfigured.native_session_context(), context);
+    assert_eq!(hooks.clone().native_session_context(), context);
+}
