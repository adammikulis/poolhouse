@@ -0,0 +1,29 @@
+use codex_protocol::ThreadId;
+
+/// Native runtime identifiers; admission and authority are validated separately.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct NativeSessionContext {
+    actor: ThreadId,
+    root: ThreadId,
+    direct_parent: Option<ThreadId>,
+}
+
+impl NativeSessionContext {
+    pub fn new(actor: ThreadId, root: ThreadId, direct_parent: Option<ThreadId>) -> Self {
+        Self {
+            actor,
+            root,
+            direct_parent,
+        }
+    }
+
+    pub fn actor(self) -> ThreadId {
+        self.actor
+    }
+    pub fn root(self) -> ThreadId {
+        self.root
+    }
+    pub fn direct_parent(self) -> Option<ThreadId> {
+        self.direct_parent
+    }
+}
