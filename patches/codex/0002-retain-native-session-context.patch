+#[test]
+fn native_session_context_preserves_root_child_and_nested_actors() {
+    let root = ThreadId::new();
+    let child = ThreadId::new();
+    let grandchild = ThreadId::new();
+    let unrelated = ThreadId::new();
+    for (actor, root, direct_parent) in [
+        (root, root, None),
+        (child, root, Some(root)),
+        (grandchild, root, Some(child)),
+        (unrelated, unrelated, None),
+    ] {
+        let (sender, _receiver) = async_channel::unbounded();
+        let context = crate::NativeSessionContext::new(actor, root, direct_parent);
+        let runtime = CommandHookRuntime::new(
+            CommandShell {
+                program: String::new(),
+                args: Vec::new(),
+            },
+            Arc::new(Vec::new()),
+            context,
+            sender,
+        );
+        for runtime in [
+            runtime.clone(),
+            runtime.reconfigured(CommandShell {
+                program: "native-context-test-shell".to_string(),
+                args: vec!["-c".to_string()],
+            }),
+        ] {
+            let actual = runtime.native_session_context();
+            assert_eq!(actual.actor(), actor);
+            assert_eq!(actual.root(), root);
+            assert_eq!(actual.direct_parent(), direct_parent);
+        }
+    }
+}
