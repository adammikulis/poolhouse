+use super::*;
+use codex_protocol::ThreadId;
+#[derive(Clone, Debug)]
+struct TestRequest;
+impl super::sealed::Request for TestRequest {}
+impl NativeHookRequest for TestRequest {
+    fn native_kind(&self) -> NativeHookKind {
+        NativeHookKind::LegacyAfterAgent
+    }
+}
+
+fn source(origin: NativeIdentityOrigin) -> Arc<NativeSessionSource> {
+    let actor = ThreadId::new();
+    NativeSessionSource::new(NativeSessionContext::new(actor, actor, None), origin)
+}
+
+#[test]
+fn original_occurrences_are_global_across_actors_and_lifecycle_labels() {
+    let birth = source(NativeIdentityOrigin::Birth);
+    let resume = source(NativeIdentityOrigin::Resume);
+    let invocation = NativeEventCapture::new(birth.clone(), NativeHookKind::LegacyAfterAgent);
+    assert_ne!(birth.lifecycle.id, resume.lifecycle.id);
+    assert_ne!(birth.lifecycle.id, invocation.occurrence.id);
+    assert_ne!(resume.lifecycle.id, invocation.occurrence.id);
+    assert_eq!(birth.lifecycle.id.launch, resume.lifecycle.id.launch);
+    assert_eq!(birth.lifecycle.kind, NativeOccurrenceKind::Birth);
+    assert_eq!(resume.lifecycle.kind, NativeOccurrenceKind::Resume);
+    assert_eq!(
+        invocation.occurrence.native_session_instance,
+        birth.lifecycle.id
+    );
+}
+
+#[test]
+fn retries_preserve_exact_arc_and_immutable_native_context() {
+    let source = source(NativeIdentityOrigin::Birth);
+    let event = NativeEventCapture::new(source.clone(), NativeHookKind::LegacyAfterAgent)
+        .with_request(TestRequest);
+    let retry = event.clone();
+    assert!(Arc::ptr_eq(&event.occurrence, &retry.occurrence));
+    assert_eq!(event.occurrence.context, source.context());
+    assert!(Arc::ptr_eq(&event.source, &retry.source));
+}
+
+#[test]
+fn fork_and_serial_exhaustion_fail_without_fallback() {
+    let issuer = Issuer {
+        process: 7,
+        epoch: SourceLaunchEpoch(Uuid::nil()),
+        next: AtomicU64::new(u64::MAX),
+    };
+    assert_eq!(issuer.try_next(8), Err(OccurrenceError::WrongProcess));
+    assert_eq!(issuer.try_next(7), Err(OccurrenceError::Exhausted));
+    assert_eq!(issuer.next.load(Ordering::Relaxed), u64::MAX);
+}
+
+#[test]
+fn fatal_capture_failure_exits_instead_of_returning_success() {
+    const CHILD: &str = "CODEX_NATIVE_OCCURRENCE_FATAL_TEST";
+    if std::env::var_os(CHILD).is_some() {
+        match issuer_from_entropy(std::process::id(), || panic!("injected entropy failure")) {
+            Err(error) => fatal(error),
+            Ok(_) => panic!("entropy failure accepted"),
+        }
+    }
+    let status = std::process::Command::new(std::env::current_exe().unwrap())
+        .env_clear()
+        .env(CHILD, "1")
+        .args([
+            "native_occurrence::tests::fatal_capture_failure_exits_instead_of_returning_success",
+            "--exact",
+        ])
+        .status()
+        .unwrap();
+    assert_eq!(status.code(), Some(1));
+}
+
+#[test]
+fn concurrent_original_events_never_reuse_a_serial() {
+    let issuer = Arc::new(Issuer {
+        process: 1,
+        epoch: SourceLaunchEpoch(Uuid::nil()),
+        next: AtomicU64::new(0),
+    });
+    let threads: Vec<_> = (0..8)
+        .map(|_| {
+            let issuer = issuer.clone();
+            std::thread::spawn(move || {
+                (0..100)
+                    .map(|_| issuer.try_next(1).unwrap().serial.get())
+                    .collect::<Vec<_>>()
+            })
+        })
+        .collect();
+    let mut serials: Vec<_> = threads
+        .into_iter()
+        .flat_map(|thread| thread.join().unwrap())
+        .collect();
+    serials.sort_unstable();
+    serials.dedup();
+    assert_eq!(serials.len(), 800);
+}
+
+#[test]
+fn child_context_retains_actual_actor_instead_of_root_shared_payload_label() {
+    let root = ThreadId::new();
+    let actor = ThreadId::new();
+    let parent = ThreadId::new();
+    let source = NativeSessionSource::new(
+        NativeSessionContext::new(actor, root, Some(parent)),
+        NativeIdentityOrigin::Birth,
+    );
+    let event = NativeEventCapture::new(source, NativeHookKind::LegacyAfterAgent);
+    assert_eq!(event.occurrence.context.actor(), actor);
+    assert_eq!(event.occurrence.context.root(), root);
+    assert_eq!(event.occurrence.context.direct_parent(), Some(parent));
+    assert_ne!(actor, root);
+}
+
+#[test]
+fn wrong_owner_and_kind_are_fatal_before_dispatch() {
+    const CHILD: &str = "CODEX_NATIVE_OCCURRENCE_OWNER_TEST";
+    if let Some(mode) = std::env::var_os(CHILD) {
+        let owner = source(NativeIdentityOrigin::Birth);
+        if mode == "owner" {
+            let event = NativeEvent::capture(owner, TestRequest);
+            event.into_parts(&source(NativeIdentityOrigin::Birth));
+        } else {
+            NativeEventCapture::new(owner, NativeHookKind::Configured(HookEventName::Stop))
+                .with_request(TestRequest);
+        }
+        panic!("invalid envelope reached dispatch");
+    }
+    for mode in ["owner", "kind"] {
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .env_clear()
+            .env(CHILD, mode)
+            .args([
+                "native_occurrence::tests::wrong_owner_and_kind_are_fatal_before_dispatch",
+                "--exact",
+            ])
+            .status()
+            .unwrap();
+        assert_eq!(status.code(), Some(1));
+    }
+}
+
+#[cfg(unix)]
+#[tokio::test]
+async fn legacy_notify_retains_occurrence_through_real_plumbing_spawn() {
+    let owner = source(NativeIdentityOrigin::Birth);
+    let temp = tempfile::tempdir().unwrap();
+    let payload = crate::HookPayload {
+        session_id: owner.context().root(),
+        cwd: codex_utils_absolute_path::AbsolutePathBuf::try_from(temp.path()).unwrap(),
+        client: None,
+        triggered_at: chrono::Utc::now(),
+        hook_event: crate::HookEvent::AfterAgent {
+            event: crate::HookEventAfterAgent {
+                thread_id: owner.context().actor(),
+                turn_id: "native-occurrence-test".into(),
+                input_messages: vec![],
+                last_assistant_message: None,
+            },
+        },
+    };
+    let event = NativeEvent::capture(owner.clone(), payload);
+    let occurrence = event.occurrence().clone();
+    let (held, payload) = event.into_parts(&owner);
+    let hook = crate::legacy_notify::notify_hook(vec!["/bin/true".into()], Arc::new(Vec::new()));
+    let result = hook.execute(held, &payload).await;
+    assert!(matches!(result.result, crate::HookResult::Success));
+    assert_eq!(
+        occurrence.observations(),
+        vec![("legacy-command", Arc::as_ptr(&occurrence) as usize)]
+    );
+}
