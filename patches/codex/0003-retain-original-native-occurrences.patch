+// Pure hook plumbing: no model, server, keystore or filesystem payload access.
+#[tokio::test]
+async fn native_occurrence_stop_two_dispatches_and_executor_retain_original_arc() {
+    let (mut engine, calls, mut request, _, _) = executor_stop_hook_fixture();
+    request.target = StopHookTarget::MemoryConsolidation;
+    let mut policy = engine.handlers[0].clone();
+    policy.source_path = cwd().join("hooks.json").into();
+    policy.source = HookSource::System;
+    Arc::make_mut(&mut engine.handlers).push(policy);
+    let event = engine.capture_native_event(request);
+    let occurrence = event.occurrence().clone();
+    let retry = event.clone();
+    assert!(Arc::ptr_eq(&occurrence, retry.occurrence()));
+    engine.run_stop(event).await;
+    wait_for_mcp_calls(&calls, 2).await;
+    let seen = occurrence.observations();
+    let identity = Arc::as_ptr(&occurrence) as usize;
+    assert_eq!(
+        seen.iter()
+            .filter(|(stage, _)| *stage == "dispatch")
+            .count(),
+        2
+    );
+    assert_eq!(seen.iter().filter(|(stage, _)| *stage == "mcp").count(), 2);
+    assert!(seen.iter().all(|(_, pointer)| *pointer == identity));
+}
