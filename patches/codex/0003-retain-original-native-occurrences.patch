+#[cfg(unix)]
+#[tokio::test]
+async fn native_occurrence_async_command_retains_exact_original_arc() {
+    let temp = tempdir().unwrap();
+    let (runtime, receiver) = runtime_with_environment(Arc::new(Vec::new()));
+    let handler = ConfiguredHandler {
+        builtin: false,
+        plugin_trust: None,
+        event_name: HookEventName::UserPromptSubmit,
+        matcher: None,
+        timeout_sec: 5,
+        status_message: None,
+        additional_context_limit: Default::default(),
+        source_path: AbsolutePathBuf::try_from(temp.path().join("hooks.json"))
+            .unwrap()
+            .into(),
+        source: HookSource::User,
+        display_order: 0,
+        kind: ConfiguredHandlerKind::Command {
+            command: "/bin/true".into(),
+            r#async: true,
+            env: HashMap::new(),
+        },
+    };
+    let engine = ClaudeHooksEngine {
+        handlers: Arc::new(vec![handler]),
+        warnings: Arc::default(),
+        required_load_errors: Arc::default(),
+        command_runtime: runtime.clone(),
+        mcp_executor: mcp_executor(),
+    };
+    let request = UserPromptSubmitRequest {
+        session_id: runtime.native_session_context().root(),
+        turn_id: "native-occurrence-test".into(),
+        subagent: None,
+        cwd: AbsolutePathBuf::try_from(temp.path()).unwrap(),
+        transcript_path: None,
+        model: String::new(),
+        permission_mode: "default".into(),
+        prompt: String::new(),
+    };
+    let event = engine.capture_native_event(request);
+    let occurrence = event.occurrence().clone();
+    engine.run_user_prompt_submit(event).await;
+    receiver.recv().await.expect("async command completion");
+    let seen = occurrence.observations();
+    assert!(seen.iter().any(|(stage, _)| *stage == "async"));
+    assert!(seen.iter().any(|(stage, _)| *stage == "command"));
+    assert!(
+        seen.iter()
+            .all(|(_, pointer)| *pointer == Arc::as_ptr(&occurrence) as usize)
+    );
+}
+
+#[test]
+fn native_occurrence_source_survives_runtime_reconfiguration() {
+    let (runtime, _) = runtime_with_environment(Arc::new(Vec::new()));
+    let source = runtime.native_source();
+    let reconfigured = runtime.reconfigured(CommandShell {
+        program: String::new(),
+        args: Vec::new(),
+    });
+    assert!(Arc::ptr_eq(&source, &reconfigured.native_source()));
+    let before = crate::native_occurrence::test_occurrence(source.clone(), HookEventName::Stop);
+    let after = crate::native_occurrence::test_occurrence(
+        reconfigured.native_source(),
+        HookEventName::Stop,
+    );
+    assert_eq!(
+        before.native_session_instance(),
+        after.native_session_instance()
+    );
+    assert_ne!(before.id(), after.id());
+}
