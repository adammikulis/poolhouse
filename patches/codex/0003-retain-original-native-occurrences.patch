+//! Original native occurrence identity DATA, never installation, launch or Node admission proof.
+//! Capture at native emitters; retries/fanout retain the same envelope. No wire/environment export.
+use std::num::NonZeroU64;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+use codex_protocol::protocol::HookEventName;
+use uuid::Uuid;
+
+use crate::NativeSessionContext;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SourceLaunchEpoch(Uuid);
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeOccurrenceId {
+    launch: SourceLaunchEpoch,
+    serial: NonZeroU64,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeIdentityOrigin {
+    Birth,
+    Resume,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeHookKind {
+    Configured(HookEventName),
+    LegacyAfterAgent,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeOccurrenceKind {
+    Birth,
+    Resume,
+    Invocation(NativeHookKind),
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum OccurrenceError {
+    Entropy,
+    WrongProcess,
+    Exhausted,
+    WrongOwner,
+    WrongKind,
+}
+
+struct Issuer {
+    process: u32,
+    epoch: SourceLaunchEpoch,
+    next: AtomicU64,
+}
+static ISSUER: OnceLock<Result<Issuer, OccurrenceError>> = OnceLock::new();
+impl Issuer {
+    fn try_next(&self, process: u32) -> Result<NativeOccurrenceId, OccurrenceError> {
+        if process != self.process {
+            return Err(OccurrenceError::WrongProcess);
+        }
+        let previous = self
+            .next
+            .try_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1))
+            .map_err(|_| OccurrenceError::Exhausted)?;
+        Ok(NativeOccurrenceId {
+            launch: self.epoch,
+            serial: NonZeroU64::new(previous + 1).ok_or(OccurrenceError::Exhausted)?,
+        })
+    }
+}
+fn fatal(error: OccurrenceError) -> ! {
+    eprintln!("native occurrence invariant failed: {error:?}");
+    // A recoverable task panic must not turn a missing enforced Stop into ordinary success.
+    std::process::exit(1)
+}
+fn issuer_from_entropy(process: u32, random: fn() -> Uuid) -> Result<Issuer, OccurrenceError> {
+    // Only the UUID source is caught. Handler/task panics retain upstream semantics.
+    let epoch = std::panic::catch_unwind(random).map_err(|_| OccurrenceError::Entropy)?;
+    Ok(Issuer {
+        process,
+        epoch: SourceLaunchEpoch(epoch),
+        next: AtomicU64::new(0),
+    })
+}
+fn issuer() -> &'static Issuer {
+    match ISSUER.get_or_init(|| issuer_from_entropy(std::process::id(), Uuid::new_v4)) {
+        Ok(issuer) => issuer,
+        Err(error) => fatal(*error),
+    }
+}
+fn next_id() -> NativeOccurrenceId {
+    issuer()
+        .try_next(std::process::id())
+        .unwrap_or_else(|error| fatal(error))
+}
+
+#[derive(Debug)]
+pub struct NativeOccurrence {
+    id: NativeOccurrenceId,
+    native_session_instance: NativeOccurrenceId,
+    context: NativeSessionContext,
+    kind: NativeOccurrenceKind,
+    #[cfg(test)]
+    observations: std::sync::Mutex<Vec<(&'static str, usize)>>,
+}
+impl NativeOccurrence {
+    fn new(
+        id: NativeOccurrenceId,
+        instance: NativeOccurrenceId,
+        context: NativeSessionContext,
+        kind: NativeOccurrenceKind,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            id,
+            native_session_instance: instance,
+            context,
+            kind,
+            #[cfg(test)]
+            observations: std::sync::Mutex::new(Vec::new()),
+        })
+    }
+    pub fn id(&self) -> NativeOccurrenceId {
+        self.id
+    }
+    pub fn native_session_instance(&self) -> NativeOccurrenceId {
+        self.native_session_instance
+    }
+    pub fn context(&self) -> NativeSessionContext {
+        self.context
+    }
+    pub fn kind(&self) -> NativeOccurrenceKind {
+        self.kind
+    }
+    #[cfg(test)]
+    pub(crate) fn observations(&self) -> Vec<(&'static str, usize)> {
+        self.observations
+            .lock()
+            .expect("occurrence observations")
+            .clone()
+    }
+    pub(crate) fn observe(&self, _stage: &'static str) {
+        #[cfg(test)]
+        self.observations
+            .lock()
+            .expect("occurrence observations")
+            .push((_stage, std::ptr::from_ref(self) as usize));
+    }
+}
+#[derive(Debug)]
+pub struct NativeSessionSource {
+    lifecycle: Arc<NativeOccurrence>,
+}
+impl NativeSessionSource {
+    /// Called once from native Session construction, never inferred from hook labels/history as proof.
+    pub fn new(context: NativeSessionContext, origin: NativeIdentityOrigin) -> Arc<Self> {
+        let id = next_id();
+        let kind = match origin {
+            NativeIdentityOrigin::Birth => NativeOccurrenceKind::Birth,
+            NativeIdentityOrigin::Resume => NativeOccurrenceKind::Resume,
+        };
+        Arc::new(Self {
+            lifecycle: NativeOccurrence::new(id, id, context, kind),
+        })
+    }
+    pub fn context(&self) -> NativeSessionContext {
+        self.lifecycle.context
+    }
+    pub fn lifecycle(&self) -> &Arc<NativeOccurrence> {
+        &self.lifecycle
+    }
+}
+
+mod sealed {
+    pub trait Request {}
+}
+/// Only maintained native request variants can classify an invocation; this is not an authority trait.
+pub trait NativeHookRequest: sealed::Request {
+    fn native_kind(&self) -> NativeHookKind;
+}
+#[derive(Debug)]
+pub struct NativeEventCapture {
+    source: Arc<NativeSessionSource>,
+    occurrence: Arc<NativeOccurrence>,
+}
+impl NativeEventCapture {
+    pub(crate) fn new(source: Arc<NativeSessionSource>, kind: NativeHookKind) -> Self {
+        let occurrence = NativeOccurrence::new(
+            next_id(),
+            source.lifecycle.id,
+            source.context(),
+            NativeOccurrenceKind::Invocation(kind),
+        );
+        Self { source, occurrence }
+    }
+    pub fn with_request<T: NativeHookRequest>(self, request: T) -> NativeEvent<T> {
+        if self.occurrence.kind != NativeOccurrenceKind::Invocation(request.native_kind()) {
+            fatal(OccurrenceError::WrongKind);
+        }
+        NativeEvent {
+            source: self.source,
+            occurrence: self.occurrence,
+            request,
+        }
+    }
+}
+#[derive(Clone, Debug)]
+pub struct NativeEvent<T> {
+    source: Arc<NativeSessionSource>,
+    occurrence: Arc<NativeOccurrence>,
+    request: T,
+}
+impl<T: NativeHookRequest> NativeEvent<T> {
+    pub(crate) fn capture(source: Arc<NativeSessionSource>, request: T) -> Self {
+        NativeEventCapture::new(source, request.native_kind()).with_request(request)
+    }
+    pub fn request(&self) -> &T {
+        &self.request
+    }
+    pub fn occurrence(&self) -> &Arc<NativeOccurrence> {
+        &self.occurrence
+    }
+    pub(crate) fn into_parts(
+        self,
+        source: &Arc<NativeSessionSource>,
+    ) -> (Arc<NativeOccurrence>, T) {
+        if issuer().process != std::process::id() {
+            fatal(OccurrenceError::WrongProcess);
+        }
+        if !Arc::ptr_eq(source, &self.source)
+            || self.occurrence.context != source.context()
+            || self.occurrence.native_session_instance != source.lifecycle.id
+        {
+            fatal(OccurrenceError::WrongOwner);
+        }
+        if self.occurrence.kind != NativeOccurrenceKind::Invocation(self.request.native_kind()) {
+            fatal(OccurrenceError::WrongKind);
+        }
+        (self.occurrence, self.request)
+    }
+}
+macro_rules! fixed_request {
+    ($ty:ty, $kind:ident) => {
+        impl sealed::Request for $ty {}
+        impl NativeHookRequest for $ty {
+            fn native_kind(&self) -> NativeHookKind {
+                NativeHookKind::Configured(HookEventName::$kind)
+            }
+        }
+    };
+}
+fixed_request!(crate::PreToolUseRequest, PreToolUse);
+fixed_request!(crate::PermissionRequestRequest, PermissionRequest);
+fixed_request!(crate::PostToolUseRequest, PostToolUse);
+fixed_request!(crate::PreCompactRequest, PreCompact);
+fixed_request!(crate::PostCompactRequest, PostCompact);
+fixed_request!(crate::UserPromptSubmitRequest, UserPromptSubmit);
+fixed_request!(crate::SessionEndRequest, SessionEnd);
+fixed_request!(crate::InterruptRequest, Interrupt);
+impl sealed::Request for crate::SessionStartRequest {}
+impl NativeHookRequest for crate::SessionStartRequest {
+    fn native_kind(&self) -> NativeHookKind {
+        NativeHookKind::Configured(self.target.event_name())
+    }
+}
+impl sealed::Request for crate::StopRequest {}
+impl NativeHookRequest for crate::StopRequest {
+    fn native_kind(&self) -> NativeHookKind {
+        NativeHookKind::Configured(self.target.event_name())
+    }
+}
+impl sealed::Request for crate::ModelRequestHookInput {}
+impl NativeHookRequest for crate::ModelRequestHookInput {
+    fn native_kind(&self) -> NativeHookKind {
+        NativeHookKind::Configured(self.event.hook_event())
+    }
+}
+impl sealed::Request for crate::HookPayload {}
+impl NativeHookRequest for crate::HookPayload {
+    fn native_kind(&self) -> NativeHookKind {
+        NativeHookKind::LegacyAfterAgent
+    }
+}
