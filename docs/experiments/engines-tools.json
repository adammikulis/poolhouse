[
  {"id": "weather", "ask": "What is the weather in Lisbon right now? Use celsius.",
   "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Current weather of a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string"}, "unit": {"type": "string", "enum": ["celsius", "fahrenheit"]}}, "required": ["city", "unit"]}}}],
   "expect": {"name": "get_weather", "args": {"city": "Lisbon", "unit": "celsius"}}},
  {"id": "pick-read", "ask": "Open config/limits.toml and tell me what is in it.",
   "tools": [{"type": "function", "function": {"name": "list_directory", "description": "List a directory.", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}},
             {"type": "function", "function": {"name": "read_file", "description": "Read one file.", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}],
   "expect": {"name": "read_file", "args": {"path": "config/limits.toml"}}},
  {"id": "integer", "ask": "Roll back the deployment of service 'billing' by exactly three releases.",
   "tools": [{"type": "function", "function": {"name": "rollback", "description": "Roll a service back.", "parameters": {"type": "object", "properties": {"service": {"type": "string"}, "releases": {"type": "integer"}}, "required": ["service", "releases"]}}}],
   "expect": {"name": "rollback", "args": {"service": "billing", "releases": 3}}},
  {"id": "boolean", "ask": "Create a branch called fix/timeout from the current one, and switch to it.",
   "tools": [{"type": "function", "function": {"name": "create_branch", "description": "Create a git branch.", "parameters": {"type": "object", "properties": {"name": {"type": "string"}, "checkout": {"type": "boolean"}}, "required": ["name", "checkout"]}}}],
   "expect": {"name": "create_branch", "args": {"name": "fix/timeout", "checkout": true}}},
  {"id": "choose-search", "ask": "Find every place the code mentions the word retry_budget.",
   "tools": [{"type": "function", "function": {"name": "run_tests", "description": "Run the test suite.", "parameters": {"type": "object", "properties": {}}}},
             {"type": "function", "function": {"name": "search_code", "description": "Search the code for a text.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}}],
   "expect": {"name": "search_code", "args": {"query": "retry_budget"}}},
  {"id": "compute", "ask": "Book meeting room B2 for 45 minutes starting at 14:15.",
   "tools": [{"type": "function", "function": {"name": "book_room", "description": "Book a room.", "parameters": {"type": "object", "properties": {"room": {"type": "string"}, "start": {"type": "string", "description": "HH:MM"}, "minutes": {"type": "integer"}}, "required": ["room", "start", "minutes"]}}}],
   "expect": {"name": "book_room", "args": {"room": "B2", "start": "14:15", "minutes": 45}}},
  {"id": "from-context", "ask": "The failing test is tests/test_queue.py::test_requeue. Run only that test.",
   "tools": [{"type": "function", "function": {"name": "run_test", "description": "Run one test by id.", "parameters": {"type": "object", "properties": {"test_id": {"type": "string"}}, "required": ["test_id"]}}}],
   "expect": {"name": "run_test", "args": {"test_id": "tests/test_queue.py::test_requeue"}}},
  {"id": "unit-conversion", "ask": "Set the upload limit to 2 gibibytes, given in mebibytes.",
   "tools": [{"type": "function", "function": {"name": "set_upload_limit", "description": "Set the upload limit.", "parameters": {"type": "object", "properties": {"mebibytes": {"type": "integer"}}, "required": ["mebibytes"]}}}],
   "expect": {"name": "set_upload_limit", "args": {"mebibytes": 2048}}}
]
