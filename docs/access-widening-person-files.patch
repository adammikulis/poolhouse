+def test_the_release_question_lists_a_guard_whose_name_git_would_quote_and_every_harness_file(tmp_path):
+    repo = repository(tmp_path / "repo")
+    state = tmp_path / "state"
+    named = [".claude/agents/é.md", ".codex/config.toml", ".agents/skills/x.md", ".vscode/tasks.json", ".mcp.json"]
+    for name in named:
+        (repo / name).parent.mkdir(parents=True, exist_ok=True)
+        commit(repo, name)
+    question = proposal(repo, state)[0]
+    guards = next(line for line in question.splitlines() if line.startswith("Guards changed: "))
+    for name in named:
+        assert name in guards, (name, guards)
+
+
+def test_a_release_question_that_cannot_ask_git_says_unknown_and_not_none(tmp_path):
+    from poolhouse.workspace import person_release
+    assert person_release._guards_changed(str(tmp_path / "not-a-repository"), "a" * 40, "b" * 40) == "unknown"
+    repo = repository(tmp_path / "repo")
+    assert person_release._guards_changed(str(repo), "a" * 40, "b" * 40) == "unknown"
