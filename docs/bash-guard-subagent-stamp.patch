+def subagent_stamped(event: dict, given: dict) -> dict | None:
+    """The tool input of a subagent's command with the subagent's identity set in the shell, or None for any other caller.
+
+    The shell inherits the identity of the session that started the subagent; the start hook's record of the subagent
+    replaces it, and a subagent with no record has none, so its workspace commands are refused."""
+    agent = str(event.get("agent_id") or "")
+    if not agent or not isinstance(given.get("command"), str):
+        return None
+    import subagent_records
+    record = subagent_records.load(agent)
+    lines = [f"export POOLHOUSE_SUBAGENT={shlex.quote(subagent_records.native_key(agent))}",
+             "unset POOLHOUSE_WORKSPACE_TOKEN"]
+    lines.append(f"export POOLHOUSE_WORKSPACE_AGENT={shlex.quote(record['name'])}" if record.get("name")
+                 else "unset POOLHOUSE_WORKSPACE_AGENT")
+    if record.get("board"):
+        lines.append(f"export POOLHOUSE_BOARD={shlex.quote(record['board'])}")
+    return {**given, "command": "\n".join(lines) + "\n" + given["command"]}
 
 
