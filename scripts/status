#!/usr/bin/env python3
"""Is anything stuck? The verdict first, then the local test broker, the test jobs and the GitHub runs of the development branch.

    scripts/status             the verdict line ('ok' or 'STUCK: ...') and the three sections
    scripts/status --verdict   only the verdict line

See scripts/runstatus.py for what counts as stuck.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import runstatus

if __name__ == "__main__":
    raise SystemExit(runstatus.main(sys.argv[1:]))
