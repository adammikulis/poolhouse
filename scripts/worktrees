#!/usr/bin/env python3
"""Every worktree as landed or work, and the two ways to remove one.

    worktrees [--target REV]              report; a long or stale branch gets a note under its line; exits 1 only for a tree it cannot read
    worktrees close TREE --landed         remove a clean tree whose commits are all in the development branch
    worktrees close TREE --bundle         bundle its unlanded commits, verify the bundle, then remove
    worktrees close TREE --abandon WHY    save the uncommitted changes, remove the tree, keep its branch with WHY as the description
    worktrees sweep [--min-age SECONDS]   remove every landed tree untouched for ten minutes (600 seconds)
                                          that no process is working in; a new tree, and one a live agent or
                                          claim holds, is removed only after a day untouched

A tree is landed when it is clean (ignored files that a build or a test run recreates do not count) and
every commit is in the development branch, the branch the primary checkout is on; it is new when it is clean
and its branch has no commit or other history since it was created; any other tree is work
and is never removed except by ``close``. Notes (information only, listed in docs/limits.md): more than 10 commits
ahead, more than 30 ahead (split or land part), more than 20 behind, and behind without a merge of the development
branch within a day. See docs/worktrees.md.
"""

from __future__ import annotations

import argparse
import functools
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

import sealed_git as lg
import primary_sync
import tree_owners

from poolhouse import trees
from poolhouse.serve.process import working_directories

NOTE_COMMITS = 10
NOTE_AHEAD = 30
NOTE_BEHIND = 20
NOTE_AGE_BEHIND_DAYS = 1.0


def flags_for(ahead: int, behind: int, age_days: float) -> tuple[str, ...]:
    """The notes for this standing: information that refuses nothing."""
    out = []
    if ahead > NOTE_AHEAD:
        out.append(f"ahead>{NOTE_AHEAD}: split or land part (note only; NOTE_AHEAD in scripts/worktrees)")
    elif ahead > NOTE_COMMITS:
        out.append(f"commits>{NOTE_COMMITS} (note only; NOTE_COMMITS in scripts/worktrees)")
    if behind > NOTE_BEHIND:
        out.append(f"behind>{NOTE_BEHIND}: merge or rebase (note only; NOTE_BEHIND in scripts/worktrees)")
    elif behind and age_days > NOTE_AGE_BEHIND_DAYS:
        out.append(f"behind and not merged within {NOTE_AGE_BEHIND_DAYS:.0f} day (note only; NOTE_AGE_BEHIND_DAYS in scripts/worktrees)")
    return tuple(out)


def report(target: str) -> int:
    """One line per tree, with a line under it for each note; 1 only when a tree cannot be read."""
    found = trees.rows(lg.toplevel(Path.cwd()), time.time(), target)
    unreadable = False
    for row in found:
        flags = flags_for(row["ahead"], row["behind"], row["tip_age_d"])
        state = "landed" if row["landed"] else "new" if row["new"] else "work"
        if "unreadable" in row:
            flags, state, unreadable = (*flags, f"unreadable: {row['unreadable']}"), "work unreadable", True
        print(f"{'NOTE' if flags else 'ok  '} {row['branch']}  +{row['ahead']} -{row['behind']}  {row['tip_age_d']:.1f}d  "
              f"{row['path']}  [{state} unlanded={row['unlanded']} dirty={row['dirty']}]")
        for flag in flags:
            print(f"       {flag}")
    return 1 if unreadable else 0


def command(argv: list[str]) -> int:
    """Run ``close`` or ``sweep``."""
    parser = argparse.ArgumentParser(prog="worktrees")
    sub = parser.add_subparsers(dest="cmd", required=True)
    close = sub.add_parser("close")
    close.add_argument("tree")
    how = close.add_mutually_exclusive_group(required=True)
    how.add_argument("--landed", action="store_true")
    how.add_argument("--bundle", action="store_true")
    how.add_argument("--abandon", metavar="REASON")
    sub.add_parser("sweep").add_argument("--min-age", type=float, default=trees.MIN_AGE_S, metavar="SECONDS")
    args = parser.parse_args(argv)
    root = lg.toplevel(Path.cwd())
    try:
        if args.cmd == "close":
            mode = "landed" if args.landed else "bundle" if args.bundle else "abandon"
            print(json.dumps(trees.close(root, args.tree, (mode, args.abandon or ""))))
            return 0
        closed, stayed = trees.sweep(root, time.time(), working_directories, args.min_age,
                                    functools.cache(tree_owners.owned))
    except (trees.Refused, RuntimeError) as error:
        print(f"worktrees: {error}", file=sys.stderr)
        return 2
    for done in closed:
        print(f"swept {done['path']} ({done['branch']})")
    for path, why in stayed:
        print(f"worktrees: kept {path}: {why}", file=sys.stderr)
    print(primary_sync.follow_origin(root))
    return 0


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if args and args[0] in ("close", "sweep"):
        return command(args)
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--target", default="")
    return report(parser.parse_args(args).target)


if __name__ == "__main__":
    sys.exit(main())
