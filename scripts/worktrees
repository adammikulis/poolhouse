#!/usr/bin/env python3
"""Every worktree as landed or work, and the two ways to remove one.

    worktrees [--target REV]              report; exits 1 on a tree over a hygiene limit
    worktrees close TREE --landed         remove a clean tree whose commits are all in the development branch
    worktrees close TREE --bundle         bundle its unlanded commits, verify the bundle, then remove
    worktrees close TREE --abandon WHY    remove a clean tree, keeping its branch with WHY as the description
    worktrees sweep [--min-age SECONDS]   remove every landed tree untouched for ten minutes (600 seconds)

A tree is landed when it is clean (ignored files that a build or a test run recreates do not count) and
every commit is in the development branch, the branch the primary checkout is on; any other tree is work
and is never removed except by ``close``. Limits (AGENTS.md, "Branch hygiene and landing"): at most 10
commits, at most 30 ahead (split or land part before adding more), at most 20 behind, and a branch that
is behind has merged the development branch within the last day. See docs/worktrees.md.
"""

from __future__ import annotations

import argparse
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

import land_git as lg

from poolhouse import trees

MAX_COMMITS = 10
MAX_AHEAD = 30
MAX_BEHIND = 20
MAX_AGE_BEHIND_DAYS = 1.0


def flags_for(ahead: int, behind: int, age_days: float) -> tuple[str, ...]:
    """The limits this standing is over."""
    out = []
    if ahead > MAX_AHEAD:
        out.append(f"ahead>{MAX_AHEAD}: split or land part")
    elif ahead > MAX_COMMITS:
        out.append(f"commits>{MAX_COMMITS}")
    if behind > MAX_BEHIND:
        out.append(f"behind>{MAX_BEHIND}: merge or rebase")
    elif behind and age_days > MAX_AGE_BEHIND_DAYS:
        out.append("behind and not merged within a day")
    return tuple(out)


def report(target: str) -> int:
    """One line per tree, with a line under it for each limit it is over."""
    found = trees.rows(lg.toplevel(Path.cwd()), time.time(), target)
    over = False
    for row in found:
        flags = flags_for(row["ahead"], row["behind"], row["tip_age_d"])
        over = over or bool(flags)
        state = "landed" if row["landed"] else "work"
        print(f"{'FLAG' if flags else 'ok  '} {row['branch']}  +{row['ahead']} -{row['behind']}  {row['tip_age_d']:.1f}d  "
              f"{row['path']}  [{state} unlanded={row['unlanded']} dirty={row['dirty']}]")
        for flag in flags:
            print(f"       {flag}")
    return 1 if over else 0


def command(argv: list[str]) -> int:
    """Run ``close`` or ``sweep``."""
    parser = argparse.ArgumentParser(prog="worktrees")
    sub = parser.add_subparsers(dest="cmd", required=True)
    close = sub.add_parser("close")
    close.add_argument("tree")
    how = close.add_mutually_exclusive_group(required=True)
    how.add_argument("--landed", action="store_true")
    how.add_argument("--bundle", action="store_true")
    how.add_argument("--abandon", metavar="REASON")
    sub.add_parser("sweep").add_argument("--min-age", type=float, default=trees.MIN_AGE_S, metavar="SECONDS")
    args = parser.parse_args(argv)
    root = lg.toplevel(Path.cwd())
    try:
        if args.cmd == "close":
            mode = "landed" if args.landed else "bundle" if args.bundle else "abandon"
            print(json.dumps(trees.close(root, args.tree, (mode, args.abandon or ""))))
            return 0
        closed, stayed = trees.sweep(root, time.time(), args.min_age)
    except (trees.Refused, RuntimeError) as error:
        print(f"worktrees: {error}", file=sys.stderr)
        return 2
    for done in closed:
        print(f"swept {done['path']} ({done['branch']})")
    for path, why in stayed:
        print(f"worktrees: kept {path}: {why}", file=sys.stderr)
    return 0


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if args and args[0] in ("close", "sweep"):
        return command(args)
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--target", default="")
    return report(parser.parse_args(args).target)


if __name__ == "__main__":
    sys.exit(main())
