#!/usr/bin/env python3
"""Run repository App operations through the selected installed implementation."""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if not sys.flags.isolated:
    sys.path.insert(0, str(ROOT / "src"))

from poolhouse import runtime  # noqa: E402

if __name__ == "__main__" and not sys.flags.isolated:
    runtime.rerun(Path(__file__).resolve(), sys.argv[1:])

from poolhouse.workspace.github_identity import command  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(command())
