#!/usr/bin/env python3
"""Land one branch on the development branch.

    scripts/land [BRANCH] [--dry-run] [--agent NAME]

Run it from the branch's worktree (BRANCH defaults to the branch checked out there). The lander that runs is the primary
checkout's, which must hold the same scripts/land*.py and scripts/affected*.py as origin's development branch: a branch's own
copy of the lander is never run. It fetches origin, rebases the branch when that needs no review (a reviewed tip gets origin
merged into it), asks the board for an independent accept of the exact commit when the diff touches anything sensitive, runs
the checks the diff calls for in a clean environment, pushes that commit to origin and fast-forwards the primary checkout,
then removes the worktree and the branch. A branch no session ever claimed records the caller as its creator at the first
run. One lander runs at a time; a second is refused naming the first. --dry-run fetches, reports whether another agent must
`poolhouse-workspace land-review`, and lists the checks.

Exit status: 0 landed (or already landed), 5 stopped (the last line says why), 6 landed and the local development
branch could not follow. A run that was interrupted is repaired by running it again.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path


def primary_land() -> Path | None:
    """The scripts/land of the primary checkout of the repository around the working directory, or None outside a repository."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    done = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=Path.cwd(), env=env,
                          capture_output=True, text=True, check=False)
    common = Path(done.stdout.strip()) if done.returncode == 0 and done.stdout.strip() else None
    return common.parent / "scripts" / "land" if common is not None and common.name == ".git" else None


def main() -> int:
    """Hand over to the primary checkout's lander when this file is another copy, then parse the command line and land."""
    target = primary_land()
    if target is not None and not (target.is_file() and os.path.samefile(target, __file__)):
        if not target.is_file():
            print(f"land: stopped: {target} does not exist; the primary checkout holds the lander that runs")
            return 5
        os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
    import land_git as lg
    import land_steps

    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("branch", nargs="?", default="", help="the branch to land (default: the branch of this worktree)")
    parser.add_argument("--dry-run", action="store_true", help="report the review and the checks; change nothing")
    parser.add_argument("--agent", default="", help="the subagent name whose session lands (default: this session)")
    args = parser.parse_args()
    try:
        root = lg.toplevel(Path.cwd())
    except RuntimeError:
        print("land: stopped: run it inside a worktree of the repository")
        return 5
    return land_steps.land(root, args.branch, args.agent, args.dry_run)


if __name__ == "__main__":
    raise SystemExit(main())
