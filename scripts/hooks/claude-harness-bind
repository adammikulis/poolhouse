#!/usr/bin/env python3
"""A UserPromptSubmit hook: records the harness process that runs the session, for `harness-ancestry`. It never blocks."""

from __future__ import annotations

import workspace_hook


POOLHOUSE_ENTRY_POINT = "records the harness process in the person folder"


def main() -> int:
    event = workspace_hook.event("UserPrompt")
    return 0 if event is None else workspace_hook.bind_harness(event, "UserPrompt")


if __name__ == "__main__":
    raise SystemExit(main())
