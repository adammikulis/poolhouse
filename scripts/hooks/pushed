#!/usr/bin/env python3
"""Check what an agent pushes: Python parses, no data files, no commit with a standing reject, the tests the push can break pass, and a warning for a merged worktree that outlives a push.

    pushed DEV   reads pre-push lines on stdin; DEV is the development branch
"""

from __future__ import annotations

import ast
import shlex
import subprocess
import sys
from pathlib import Path

ZERO = "0" * 40
ASK_TIMEOUT_S = 10.0
HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE.parent), str(HERE.parents[1] / "src")]
try:
    import sealed_git as lg
except ImportError as exc:
    raise SystemExit(f"pushed: the git helper could not load ({exc}); the push is refused") from None
try:
    import affected_push
except ImportError as exc:
    raise SystemExit(f"pushed: the affected-test check could not load ({exc}); the push is refused") from None
try:
    import ci_watch
except ImportError as exc:
    ci_watch = None
    print(f"pushed: warning: the ci watcher could not load ({exc}); the ci run is not watched", file=sys.stderr)
try:
    import primary_sync
except ImportError as exc:
    primary_sync = None
    print(f"pushed: warning: the primary checkout sync could not load ({exc}); the primary checkout is not moved", file=sys.stderr)


def _git(*args: str) -> subprocess.CompletedProcess[str]:
    """``git args`` in the pushing checkout, with the caller's configuration, for refs and worktrees."""
    return lg.git(Path.cwd(), *args, check=False)


def ever_moved(branch: str) -> bool:
    """Whether the branch's reflog holds anything besides its creation."""
    log = _git("reflog", "show", "--format=%gs", f"refs/heads/{branch}").stdout.splitlines()
    return any(not entry.startswith("branch: Created from") for entry in log)


def leftover_worktrees(tip: str) -> list[tuple[str, str]]:
    """``(path, branch)`` of unlocked worktrees whose branch has no commit outside ``tip``."""
    out = []
    root = Path.cwd()
    blocks = _git("worktree", "list", "--porcelain").stdout.strip().split("\n\n")[1:]
    for block in blocks:
        keys = dict([*ln.split(" ", 1), ""][:2] for ln in block.splitlines())
        branch = keys.get("branch", "").removeprefix("refs/heads/")
        if "locked" in keys or not branch or not ever_moved(branch):
            continue
        head = _git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}").stdout.strip()
        if head and (lg.is_ancestor(root, head, tip)
                     or not any(ln.startswith("+") for ln in lg.sealed(root, "cherry", tip, head, check=False).stdout.splitlines())):
            out.append((keys["worktree"], branch))
    return out


def unparseable(base: str, tip: str) -> list[str]:
    """Python files changed in ``base..tip`` that do not parse at ``tip``."""
    root = Path.cwd()
    names = lg.changed(root, base, tip, "--diff-filter=ACMR") if lg.commit_id(root, base) else lg.unpushed_names(root, tip)
    bad = []
    for name in sorted({n for n in names if n.endswith(".py")}):
        source = lg.blob(root, tip, name)
        if source is None:
            continue
        try:
            ast.parse(source, filename=name)
        except SyntaxError as exc:
            bad.append(f"  {name}:{exc.lineno}: {exc.msg}")
        except ValueError as exc:
            bad.append(f"  {name}: {exc}")
    return bad


def warn(text: str) -> None:
    """One ``pushed: warning:`` line on stderr."""
    print(f"pushed: warning: {text}", file=sys.stderr)


def rejected(tip: str) -> list[str]:
    """The new commits of ``tip`` (those on no remote-tracking ref) that a reviewer rejected and that stand.

    A review is advice: a checkout, a session or a board that cannot be asked is a warning on stderr and the push goes on. The node is
    asked without starting it and for at most ``ASK_TIMEOUT_S`` a call; an error on one commit leaves the rejects found on the others,
    and a node that stops answering ends the questions.
    """
    root = Path.cwd()
    try:
        from poolhouse.board import session
        from poolhouse.board.client import Client
        from poolhouse.errors import Error
        from poolhouse.workspace import landing
    except ImportError as exc:
        warn(f"the reject check could not load ({exc}); reviews are not read")
        return []
    try:
        asked = session.connect(cwd=lg.toplevel(root), client=Client(autostart=False, timeout=ASK_TIMEOUT_S))
        commits = lg.sealed(root, "rev-list", "--stdin", stdin=lg.unpushed(root, tip)).stdout.split()
    except (OSError, ValueError, RuntimeError, KeyError, Error) as exc:
        warn(f"the board could not be asked for reviews ({exc}); the push is not checked for a reject")
        return []
    found = []
    for sha in commits:
        try:
            if landing.rejected(asked, landing.accepts(asked, sha)):
                found.append(sha)
        except OSError as exc:
            warn(f"the board did not answer about {sha[:12]} ({exc}); the commits from there are not checked for a reject")
            break
        except (ValueError, RuntimeError, KeyError, Error) as exc:
            warn(f"the reviews of {sha[:12]} could not be read ({exc}); that commit is not checked for a reject")
    return found


def watch_ci(dev: str, tips: list[str]) -> None:
    """Start the detached watcher of the GitHub `ci` run of each pushed development tip; a failure to start is a warning."""
    for tip in tips if ci_watch else []:
        try:
            ci_watch.start(tip, dev, Path.cwd())
        except (OSError, RuntimeError) as exc:
            print(f"pushed: warning: the ci run of {tip[:12]} is not watched ({exc})", file=sys.stderr)


def follow(dev: str, tips: list[str]) -> None:
    """Start the detached fast-forward of the primary checkout to the newest pushed development tip; a failure to start is a warning."""
    if not tips or primary_sync is None:
        return
    try:
        primary_sync.start(tips[-1], dev, Path.cwd())
    except (OSError, RuntimeError) as exc:
        print(f"pushed: warning: the primary checkout is not moved after this push ({exc})", file=sys.stderr)


def main(dev: str, lines: list[str]) -> int:
    """Return 1 when any pushed ref is refused."""
    refused = failed = 0
    tips = []
    for line in lines:
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:
            continue
        _, tip, remote_ref, base = parts
        if remote_ref == f"refs/heads/{dev}":
            tips.append(tip)
            for sha in rejected(tip):
                refused = 1
                print(f"pushed: {remote_ref} carries {sha[:12]}, which an independent reviewer rejected; replace that commit (an amend or "
                      f"a rebase gives it a new id; a commit on top leaves it in the push) or the reviewer posts: "
                      f"poolhouse-workspace land-review BRANCH {sha} --verdict accept", file=sys.stderr)
            for where, branch in leftover_worktrees(tip):
                print(f"pushed: warning: {branch} has nothing outside {dev}; remove its worktree:",
                      f"  git worktree remove {shlex.quote(where)}", f"  git branch -d {shlex.quote(branch)}", sep="\n", file=sys.stderr)
        try:
            bad = unparseable(base, tip)
        except RuntimeError as exc:
            bad = [f"  the pushed files could not be read ({exc})"]
        if bad:
            refused = failed = 1
            print(f"pushed: {remote_ref} carries Python that does not parse:\n" + "\n".join(bad),
                  file=sys.stderr)
        if subprocess.run([sys.executable, str(HERE / "no-data-files"), "--range", base, tip],
                          check=False).returncode != 0:
            refused = failed = 1
        if remote_ref == f"refs/heads/{dev}" and not (failed or refused):
            refused = affected_push.check(dev, base, tip)
    if not refused:
        watch_ci(dev, tips)
        follow(dev, tips)
    if failed:
        print("\nEvery pushed commit passes the pre-commit hooks. Fix it in a new commit.", file=sys.stderr)
    return refused


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit(__doc__)
    raise SystemExit(main(sys.argv[1], sys.stdin.read().splitlines()))
