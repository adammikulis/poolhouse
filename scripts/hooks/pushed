#!/usr/bin/env python3
"""Check what an agent pushes: Python parses, no data files, an independent accept for a sensitive diff of the development
branch, and a warning for a merged worktree that outlives a push.

    pushed DEV   reads pre-push lines on stdin; DEV is the development branch
"""

from __future__ import annotations

import ast
import shlex
import subprocess
import sys
from pathlib import Path

ZERO = "0" * 40
HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE.parent), str(HERE.parents[1] / "src")]
try:
    import land_git as lg
except ImportError as exc:
    raise SystemExit(f"pushed: the git helper could not load ({exc}); the push is refused") from None


def _git(*args: str) -> subprocess.CompletedProcess[str]:
    """``git args`` in the pushing checkout, with the caller's configuration, for refs and worktrees."""
    return lg.git(Path.cwd(), *args, check=False)


def ever_moved(branch: str) -> bool:
    """Whether the branch's reflog holds anything besides its creation."""
    log = _git("reflog", "show", "--format=%gs", f"refs/heads/{branch}").stdout.splitlines()
    return any(not entry.startswith("branch: Created from") for entry in log)


def leftover_worktrees(tip: str) -> list[tuple[str, str]]:
    """``(path, branch)`` of unlocked worktrees whose branch has no commit outside ``tip``."""
    out = []
    root = Path.cwd()
    blocks = _git("worktree", "list", "--porcelain").stdout.strip().split("\n\n")[1:]
    for block in blocks:
        keys = dict([*ln.split(" ", 1), ""][:2] for ln in block.splitlines())
        branch = keys.get("branch", "").removeprefix("refs/heads/")
        if "locked" in keys or not branch or not ever_moved(branch):
            continue
        head = _git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}").stdout.strip()
        if head and (lg.is_ancestor(root, head, tip)
                     or not any(ln.startswith("+") for ln in lg.sealed(root, "cherry", tip, head, check=False).stdout.splitlines())):
            out.append((keys["worktree"], branch))
    return out


def unpushed_names(root: Path, tip: str) -> list[str]:
    """The files changed by the commits of ``tip`` that no remote-tracking ref holds."""
    done = lg.sealed(root, "log", "--format=", "--name-only", "--no-renames", "-z", "--stdin", stdin=lg.unpushed(root, tip))
    return [n for n in done.stdout.split("\0") if n]


def unparseable(base: str, tip: str) -> list[str]:
    """Python files changed in ``base..tip`` that do not parse at ``tip``."""
    root = Path.cwd()
    names = lg.changed(root, base, tip, "--diff-filter=ACMR") if lg.commit_id(root, base) else unpushed_names(root, tip)
    bad = []
    for name in sorted({n for n in names if n.endswith(".py")}):
        source = lg.blob(root, tip, name)
        if source is None:
            continue
        try:
            ast.parse(source, filename=name)
        except SyntaxError as exc:
            bad.append(f"  {name}:{exc.lineno}: {exc.msg}")
        except ValueError as exc:
            bad.append(f"  {name}: {exc}")
    return bad


def trees_at(tip: str, dev: str) -> list[tuple[str, str]]:
    """``(branch, worktree path)`` of every local branch other than the development branch that points at ``tip``."""
    heads = [h.removeprefix("refs/heads/") for h in _git("for-each-ref", "--points-at", tip, "--format=%(refname)", "refs/heads").stdout.split()]
    where = {}
    for block in _git("worktree", "list", "--porcelain").stdout.strip().split("\n\n"):
        keys = dict([*ln.split(" ", 1), ""][:2] for ln in block.splitlines())
        where[keys.get("branch", "").removeprefix("refs/heads/")] = keys.get("worktree", "")
    return [(name, where.get(name, "")) for name in heads if name not in (dev, "main", "master")]


def unreviewed(dev: str, tip: str, remote: str) -> str:
    """Why pushing ``tip`` over ``remote``, the commit the remote holds, lacks the independent accept its diff needs, or an empty string.

    The diff starts from ``remote`` as git read it from the remote; a commit this checkout lacks makes the whole tip the diff.
    Asks the node whether an accept of exactly ``tip`` stands for some branch pointing at it; a node that does not answer, or a
    checkout that cannot ask, refuses. A merge commit of ``remote`` and a second parent, whose tree is exactly their conflict-free
    automatic merge, also passes when the second parent has such an accept.
    """
    try:
        import land_review

        from poolhouse.board import session
        from poolhouse.errors import Error
        from poolhouse.workspace import landing
    except ImportError as exc:
        return f"the review check could not load ({exc})"
    first = ""
    try:
        root = lg.toplevel(Path.cwd())
        needed, _, first = land_review.required(root, remote, tip)
        if not needed:
            return ""
        parent, second = land_review.merged_parents(root, tip)
        reviewed = [tip, second] if second and parent == remote else [tip]
        branches = trees_at(tip, dev) + (trees_at(second, dev) if len(reviewed) > 1 else [])
        if not branches:
            return f"no branch other than {dev} points at {tip[:12]}; push a branch tip"
        s = session.connect(cwd=root)
        why = ""
        for name, path in branches:
            for sha in reviewed:
                why = landing.standing(s, landing.accepts(s, name, sha, path))
                if not why:
                    return ""
        return f"{why} for {reviewed[-1][:12]} (first sensitive path {first}); another agent runs: poolhouse-workspace land-review {branches[0][0]} {reviewed[-1]} --verdict accept"
    except (OSError, ValueError, RuntimeError, KeyError, Error) as exc:
        return f"the board could not be asked ({exc}) about {first or 'the diff'}"


def main(dev: str, lines: list[str]) -> int:
    """Return 1 when any pushed ref is refused."""
    refused = 0
    for line in lines:
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:
            continue
        _, tip, remote_ref, base = parts
        if remote_ref == f"refs/heads/{dev}":
            why = unreviewed(dev, tip, base)
            if why:
                refused = 1
                print(f"pushed: {remote_ref} needs an independent review: {why}", file=sys.stderr)
            for where, branch in leftover_worktrees(tip):
                print(f"pushed: warning: {branch} has nothing outside {dev}; remove its worktree:",
                      f"  git worktree remove {shlex.quote(where)}", f"  git branch -d {shlex.quote(branch)}", sep="\n", file=sys.stderr)
        try:
            bad = unparseable(base, tip)
        except RuntimeError as exc:
            bad = [f"  the pushed files could not be read ({exc})"]
        if bad:
            refused = 1
            print(f"pushed: {remote_ref} carries Python that does not parse:\n" + "\n".join(bad),
                  file=sys.stderr)
        if subprocess.run([sys.executable, str(HERE / "no-data-files"), "--range", base, tip],
                          check=False).returncode != 0:
            refused = 1
    if not refused:
        subprocess.run([sys.executable, str(HERE / "runtime-refresh"), "pushed"], check=False)
    if refused:
        print("\nEvery pushed commit passes the pre-commit hooks. Fix it in a new commit.", file=sys.stderr)
    return refused


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit(__doc__)
    raise SystemExit(main(sys.argv[1], sys.stdin.read().splitlines()))
