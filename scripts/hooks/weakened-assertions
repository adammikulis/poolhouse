#!/usr/bin/env python3
"""Report a diff that weakens a guard, authority or red-team test, unless a second reviewer signed.

    weakened-assertions --staged --message FILE   the staged diff (commit-msg)
    weakened-assertions --against REV [--report]  REV..HEAD and its messages (CI)

Covers tests/ files named test_redteam_*, test_*guard* or test_*auth*, and files that use the
redteam marker. Weakening is fewer assertions than before, a removed test function, or an added
skip, skipif or xfail. A `Reviewed-by-second:` or `Owner-order:` line in the commit message accepts the diff.
A pull request that changes such a test merges only with an attack review (docs/landing.md), so on a branch that is neither main
nor the primary checkout's, and with --report, what is weaker is printed and nothing is refused.
Every diff is read as text, whatever attributes and diff settings the repository carries, and over the whole repository from
whichever of its folders the check starts in. Exit 0 when nothing is weakened, the message accepts it or it is only reported, 1
with the list, and 2 when git does not give what the check has to read, or --against names no commit.
"""

from __future__ import annotations

import argparse
import fnmatch
import os
import re
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import merge_history  # noqa: E402
import renames  # noqa: E402

NAMES = ("test_redteam_*", "test_*guard*", "test_*auth*")
SIGN = re.compile(r"^(Reviewed-by-second|Owner-order):\s*\S", re.M)
ASSERT = re.compile(r"^\s*(assert\b|self\.assert\w*\(|with pytest\.raises\b|pytest\.raises\()")
DEF = re.compile(r"^\s*(?:async\s+)?def (test\w*)\(")
SKIP = re.compile(r"pytest\.(mark\.(skip|skipif|xfail)\b|skip\(|xfail\(|importorskip\()")
MARK = re.compile(r"mark\.redteam\b|^pytestmark\b.*redteam", re.M)
SAME_FILE_PREFIX = 16
DIFF = ("-c", "core.quotePath=false", "diff", "--text", "--no-ext-diff", "--no-textconv", "--no-color", "--src-prefix=a/",
        "--dst-prefix=b/", "-U0", renames.FLAG)
"""A diff no attribute, driver or setting can empty, colour or rename the sides of."""


def guarded(path: str, text: str) -> bool:
    """Whether a test file is one whose assertions this check protects."""
    if not path.startswith("tests/") or not path.endswith(".py"):
        return False
    return any(fnmatch.fnmatch(Path(path).name, n) for n in NAMES) or bool(MARK.search(text))


def split(diff: str) -> dict[str, tuple[list[str], list[str]]]:
    """Removed and added lines of a zero-context diff, by new path. A line ends at a line feed only: what a file holds on one line
    never starts a line of the diff."""
    files: dict[str, tuple[list[str], list[str]]] = {}
    current = None
    for line in diff.split("\n"):
        if line.startswith("diff --git "):
            current = line.rpartition(" b/")[2]
            files[current] = ([], [])
        elif current is None or line.startswith(("---", "+++")):
            continue
        elif line.startswith("-"):
            files[current][0].append(line[1:])
        elif line.startswith("+"):
            files[current][1].append(line[1:])
    return files


def moved(diff: str) -> dict[str, str]:
    """``new path -> old path`` for each file the diff renames."""
    out: dict[str, str] = {}
    old = ""
    for line in diff.split("\n"):
        if line.startswith("rename from "):
            old = line[len("rename from "):]
        elif line.startswith("rename to "):
            out[line[len("rename to "):]] = old
    return out


def swapped(diff: str) -> dict[str, set[str]]:
    """Per file, the test names a hunk replaced by as many other test names and nothing else that is a
    test: the function was renamed, not removed. In a file that moved any new name pairs with an old
    one; in a file that did not move each pair shares a name prefix of at least ``SAME_FILE_PREFIX``
    characters. The count of assertions is checked on its own, so an edited body that keeps its
    assertions passes."""
    renamed = set(moved(diff))
    out: dict[str, set[str]] = {}
    path = ""
    gone: list[str] = []
    came: list[str] = []
    hunk = False

    def settle() -> None:
        if gone and len(gone) == len(came) and (path in renamed or all(
                len(os.path.commonprefix([a, b])) >= SAME_FILE_PREFIX for a, b in zip(gone, came))):
            out.setdefault(path, set()).update(gone)
        gone.clear()
        came.clear()

    for line in diff.split("\n"):
        if line.startswith(("diff --git ", "@@")):
            settle()
            hunk = line.startswith("@@")
            if line.startswith("diff --git "):
                path = line.rpartition(" b/")[2]
        elif hunk and line.startswith("-") and (m := DEF.match(line[1:])):
            gone.append(m.group(1))
        elif hunk and line.startswith("+") and (m := DEF.match(line[1:])):
            came.append(m.group(1))
    settle()
    return out


def check(path: str, removed: list[str], added: list[str],
          renamed_tests: frozenset[str] | set[str] = frozenset()) -> list[str]:
    """The ways this file's change weakens it; ``renamed_tests`` are removed names that came back renamed."""
    out = []
    gone = sum(bool(ASSERT.match(x)) for x in removed)
    came = sum(bool(ASSERT.match(x)) for x in added)
    if gone > came:
        passed = any(x.strip() == "pass" for x in added)
        out.append(f"{path}: {gone - came} fewer assertions"
                   + (" (replaced by pass)" if passed else ""))
    old = {m.group(1) for x in removed if (m := DEF.match(x))}
    new = {m.group(1) for x in added if (m := DEF.match(x))}
    for name in sorted(old - new - set(renamed_tests)):
        out.append(f"{path}: test function {name} removed")
    for line in added:
        if SKIP.search(line):
            out.append(f"{path}: added {SKIP.search(line).group(0).rstrip('(')}")
    return out


class Unread(RuntimeError):
    """Something the check has to read and git does not give."""


def run(*args: str) -> str:
    """Standard output of a git command that has to succeed."""
    done = merge_history.output(*args)
    if done.returncode:
        raise Unread(f"git {' '.join(args)}: {(done.stderr.strip() or f'exit {done.returncode}').splitlines()[0]}")
    return done.stdout


def merge_heads() -> list[str]:
    """The commits a merge in progress brings in: more than one for an octopus merge, none outside a merge."""
    try:
        return Path(run("rev-parse", "--git-path", "MERGE_HEAD").rstrip("\n")).read_text(encoding="utf-8").split()
    except OSError:
        return []


def merge_own(diff: str) -> str:
    """The part of a staged merge diff that the merge itself wrote, as ``git diff --cc`` would show
    it. A file whose staged content is exactly the one other parent's, is absent from both because
    the other side deleted it, or is what git's own merge of the sides writes without a conflict,
    carries only what each side wrote, in commits that were judged on their own. Any other file (a
    conflict resolved by hand, or an edit made in the merge) is judged against what a faithful merge
    keeps (``owed``): every assertion and test that survives git's merge, whatever the number of merge
    bases, and in a conflict hunk what the two sides hold less their base; it adds no skip that
    no side had. An octopus merge is judged on every file that differs from git's merge of all its heads."""
    heads = merge_heads()
    if not heads:
        return diff
    pair = len(heads) == 1
    bases = sorted({base for head in heads for base in merge_history.bases("HEAD", head)})
    merged = merge_history.merged(["HEAD", *heads])
    paths, origin = dict.fromkeys(split(diff)), moved(diff)
    if merged and not pair:
        unlike = run(*DIFF, "--cached", merged.tree, "--", "tests")
        paths.update(dict.fromkeys(split(unlike)))
        origin = {**moved(unlike), **origin}
    out = []
    for path in paths:
        was = origin.get(path, path)
        staged, incoming = object_id(f":{path}"), object_id(f"{heads[0]}:{path}")
        if pair and staged and incoming == staged:
            continue
        if pair and not staged and not incoming and any(object_id(f"{base}:{was}") for base in bases):
            continue
        if merged and path not in merged.conflicted and object_id(f"{merged.tree}:{path}") == staged:
            continue
        ours, theirs = text_at("HEAD", was), [text_at(head, path, was) for head in heads]
        now = text_at("", path)
        whole = text_at(merged.tree, path, was) if merged else ""
        hunks = any(not isinstance(region, str) for region in merge_history.regions(whole.split("\n")))
        if whole and (path not in merged.conflicted or (pair and hunks)):
            held, tests = owed(whole.split("\n"))
        else:
            roots = [text_at(base, was, path) for base in bases]
            each = [owed_by_sides(ours, one, roots) for one in theirs]
            held, tests = max(count_owed for count_owed, _ in each), set().union(*(owed_tests for _, owed_tests in each))
        before = skips(ours) + sum((skips(one) for one in theirs), Counter())
        out.append(judged(path, was, held - count(now), tests - names(now), skips(now) - before))
    return "".join(out)


def owed(lines: list[str], size: int = merge_history.MARKER_SIZE) -> tuple[int, set[str]]:
    """How many assertions and which tests a faithful merge keeps of a file as git merged it: all of those outside a conflict, and in
    each conflict hunk what the two sides hold less what their base held (a test either side removed from the base is not owed)."""
    held, tests = 0, set()
    for region in merge_history.regions(lines, size):
        if isinstance(region, str):
            held += count(region)
            tests |= names(region)
            continue
        one, base, other = (list(part) for part in region)
        was, were = agreed(base, size + 2)
        held += max(0, count("\n".join(one)) + count("\n".join(other)) - was)
        left, right = names("\n".join(one)), names("\n".join(other))
        tests |= (left | right) - (were - left) - (were - right)
    return held, tests


def agreed(lines: list[str], size: int) -> tuple[int, set[str]]:
    """The assertions and tests of a hunk's base, whose own conflicts are marked ``size`` long. Where the merge bases disagreed, only
    what both held counts, so nothing they argue over excuses a loss."""
    held, tests = 0, set()
    for region in merge_history.regions(lines, size):
        if isinstance(region, str):
            held += count(region)
            tests |= names(region)
            continue
        (first, first_tests), (second, second_tests) = agreed(region[0], size + 2), agreed(region[2], size + 2)
        held += min(first, second)
        tests |= first_tests & second_tests
    return held, tests


def owed_by_sides(ours: str, theirs: str, roots: list[str]) -> tuple[int, set[str]]:
    """``owed`` for a file git wrote no merge of (one side deleted it): what the sides hold less the bases, each base read the way that
    excuses least."""
    roots = roots or [""]
    shared = set.intersection(*(names(r) for r in roots))
    held = count(ours) + count(theirs) - min(count(r) for r in roots)
    return held, (names(ours) | names(theirs)) - (shared - names(ours)) - (shared - names(theirs))


def judged(path: str, was: str, short: int, lost: set[str], skipped: Counter) -> str:
    """The diff of one file that states exactly what it lost and which skips it gained, for ``weakened`` to read."""
    out = [f"diff --git a/{was} b/{path}\n"]
    if was != path:
        out.append(f"rename from {was}\nrename to {path}\n")
    out.extend(["-    assert lost_in_the_merge\n"] * max(0, short))
    out.extend(f"-def {name}():\n" for name in sorted(lost))
    out.extend(f"+{x}\n" for x in skipped.elements())
    return "".join(out)


def range_changes(rev: str) -> tuple[str, str]:
    """What HEAD changed since it left ``rev``, and the tree that was changed. After a criss-cross there are several merge bases and
    the history is their merge: a diff from any single one reports what the others brought, and misses what HEAD took of it."""
    found = merge_history.bases(rev, "HEAD")
    history = merge_history.merged(found) if len(found) > 1 else None
    if history is None:
        return run(*DIFF, f"{rev}...HEAD", "--", "tests"), rev
    diff = run(*DIFF, history.tree, "HEAD", "--", "tests")
    origin = moved(diff)
    stuck = {p for p in split(diff) if origin.get(p, p) in history.conflicted}
    out = [part for part in re.split(r"(?m)^(?=diff --git )", diff) if part and part.split("\n")[0].rpartition(" b/")[2] not in stuck]
    for path in sorted(stuck):
        was = origin.get(path, path)
        before, now = text_at(history.tree, was), text_at("HEAD", path)
        held, tests = owed(before.split("\n"))
        out.append(judged(path, was, held - count(now), tests - names(now), skips(now) - skips(before)))
    return "".join(out), history.tree


def text_at(rev: str | None, *paths: str) -> str:
    """The first of ``paths`` that exists at ``rev`` (the index when ``rev`` is empty), else nothing."""
    for path in paths if rev is not None else ():
        if body := show(rev, path):
            return body
    return ""


def show(rev: str, path: str) -> str:
    """``path`` at ``rev`` (the index when ``rev`` is empty), nothing where there is no such file."""
    return run("show", f"{rev}:{path}") if object_id(f"{rev}:{path}") else ""


def object_id(spec: str) -> str:
    """The id of the object ``spec`` names, empty when there is none."""
    return merge_history.output("rev-parse", "-q", "--verify", spec).stdout.strip()


def count(text: str) -> int:
    """How many assertions a file holds."""
    return sum(bool(ASSERT.match(x)) for x in text.splitlines())


def names(text: str) -> set[str]:
    """The test functions a file defines."""
    return {m.group(1) for x in text.splitlines() if (m := DEF.match(x))}


def skips(text: str) -> Counter:
    """The skip, skipif and xfail lines of a file, by text."""
    return Counter(x for x in text.splitlines() if SKIP.search(x))


def weakened(diff: str, read) -> list[str]:
    """Every weakening in a zero-context diff; read(path) is the file as it was before."""
    out = []
    origin = moved(diff)
    swaps = swapped(diff)
    for path, (removed, added) in split(diff).items():
        old = origin.get(path, path)
        text = read(old) + "\n".join(added)
        if guarded(path, text) or guarded(old, text):
            out.extend(check(path, removed, added, swaps.get(path, set())))
    return out


def judged_at_merge() -> bool:
    """Whether the commit being made reaches a released branch only through a pull request: it is on a branch that is neither main
    nor the one the primary checkout is on, which is the development branch."""
    branch = merge_history.output("symbolic-ref", "--short", "-q", "HEAD").stdout.strip()
    first = merge_history.output("worktree", "list", "--porcelain").stdout.split("\n\n")[0].split("\n")
    primary = next((line[len("branch refs/heads/"):] for line in first if line.startswith("branch refs/heads/")), "")
    return bool(branch and primary) and branch not in ("main", "master", primary)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--staged", action="store_true")
    parser.add_argument("--message", default="")
    parser.add_argument("--against")
    parser.add_argument("--report", action="store_true", help="print what is weaker and exit 0: a pull request's merge judges it")
    args = parser.parse_args(argv)
    try:
        # the message is named from the folder the check was started in; every pathspec is read from the top
        message = Path(args.message).read_text(encoding="utf-8") if args.message else ""
        os.chdir(run("rev-parse", "--show-toplevel").rstrip("\n"))
        if args.against is not None:
            against = run("rev-parse", "--verify", f"{args.against}^{{commit}}").strip()
            diff, base = range_changes(against)
            message = run("log", "--format=%B", f"{against}..HEAD")
            befores = [base]
        else:
            diff = merge_own(run(*DIFF, "--cached", "--", "tests"))
            befores = ["HEAD", *merge_heads()]
        found = weakened(diff, lambda p: "\n".join(show(rev, p) for rev in befores))
    except Unread as why:
        print(f"weakened-assertions: could not read the change, so it is not clean: {why}", file=sys.stderr)
        return 2
    if not found or SIGN.search(message):
        return 0
    print("weakened-assertions: a guard, authority or red-team test lost strength", file=sys.stderr)
    for line in found:
        print(f"  {line}", file=sys.stderr)
    if args.report or (args.against is None and judged_at_merge()):
        print("  reported, not refused: the merge of the pull request takes an attack review, which is shown this list "
              "(scripts/lead-review).", file=sys.stderr)
        return 0
    print("  add a `Reviewed-by-second: <name>` line once a second reviewer has read it, or an "
          "`Owner-order: <what the owner said>` line.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
