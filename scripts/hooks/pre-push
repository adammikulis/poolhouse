#!/bin/sh
# Development publication guards refs only. Validation and CI run separately.
set -eu

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
here=$(cd "$(dirname "$self")" && pwd)
if [ -z "${CLAUDECODE-}${POOLHOUSE_AGENT-}${POOLHOUSE_WORKSPACE_AGENT-}${CODEX_THREAD_ID-}${CODEX_SESSION_ID-}" ] &&
   ! "${PYTHON:-python3}" "$here/person-consume" harness </dev/null 2>/dev/null; then
    exit 0
fi
primary=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
dev=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git -C "$primary" branch --show-current)
zero=0000000000000000000000000000000000000000

refuse() {
    echo "pre-push: refused: ${remote_ref:-malformed record} ($1)" >&2
    echo "Push development with git push origin ${dev:-<development branch>}; release through refs/heads/promote/<date>." >&2
    exit 1
}

while read -r local_ref local_sha remote_ref remote_sha extra ||
      [ -n "$local_ref$local_sha$remote_ref$remote_sha$extra" ]; do
    [ -n "$local_ref$local_sha$remote_ref$remote_sha$extra" ] || continue
    [ -n "$local_ref" ] && [ -n "$local_sha" ] && [ -n "$remote_ref" ] &&
        [ -n "$remote_sha" ] && [ -z "$extra" ] || refuse "malformed record"
    [ "$local_sha" != "$zero" ] || refuse "deletions are not development pushes"
    [ -n "$dev" ] && [ "$dev" != main ] || refuse "no development branch"
    case "$remote_ref" in
        "refs/heads/$dev"|refs/heads/promote/?*) ;;
        *) refuse "only development and promotion snapshots are allowed" ;;
    esac
    git check-ref-format "$remote_ref" >/dev/null 2>&1 || refuse "invalid destination ref"
    case "$local_sha$remote_sha" in *[!0-9a-f]*) refuse "invalid commit identifier" ;; esac
    [ "$(git --no-replace-objects cat-file -t "$local_sha" 2>/dev/null || true)" = commit ] ||
        refuse "local tip is not a known commit"
    if [ "$remote_sha" != "$zero" ]; then
        [ "$(git --no-replace-objects cat-file -t "$remote_sha" 2>/dev/null || true)" = commit ] ||
            refuse "fetch the remote commit before pushing"
        git --no-replace-objects merge-base --is-ancestor "$remote_sha" "$local_sha" ||
            refuse "the update is not a fast-forward"
    fi
done
