#!/bin/sh
# Publication guards refs only: an agent pushes branches forward, never a tag, a deletion or a rewrite. Validation and CI run separately,
# and the development branch takes work by pull request (docs/landing.md), which GitHub's own rule enforces. A push to main by an agent is
# the one merge: it is allowed exactly when the rule the guards apply (poolhouse.workspace.release_check) allows it for the commit
# pushed, and refused at once with its reason otherwise; nothing waits for anyone.
set -eu

# This source-repository policy is opt-in local scope, never library-consumer policy.
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
common=$(cd "$common" && pwd -P) || exit 0
scope=$(git config --local --get poolhouse.hooks.repository 2>/dev/null) || exit 0
[ "$scope" = "$common" ] || exit 0

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
here=$(cd "$(dirname "$self")" && pwd)
if [ -z "${CLAUDECODE-}${POOLHOUSE_AGENT-}${POOLHOUSE_WORKSPACE_AGENT-}${CODEX_THREAD_ID-}${CODEX_SESSION_ID-}" ] &&
   ! "${PYTHON:-python3}" "$here/harness-ancestry" </dev/null 2>/dev/null; then
    exit 0
fi
primary=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
dev=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git -C "$primary" branch --show-current)
zero=0000000000000000000000000000000000000000

refuse() {
    echo "pre-push: refused: ${remote_ref:-malformed record} ($1)" >&2
    echo "Push your own branch and open a pull request into ${dev:-<development branch>}; release through refs/heads/promote/<date>." >&2
    exit 1
}

# Why the agent may not publish $1 to main, empty when it may: the commit has a standing independent land-review accept and the checkout is clean.
release_refusal() {
    src="$here/../../src"
    PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}" "${PYTHON:-python3}" -c '
import sys
from poolhouse.workspace import release_check
sys.stdout.write(release_check.refusal(".", {"CLAUDECODE": "1"}, sys.argv[1]))' "$1" </dev/null 2>/dev/null ||
        echo "the release check could not run"
}

while read -r local_ref local_sha remote_ref remote_sha extra ||
      [ -n "$local_ref$local_sha$remote_ref$remote_sha$extra" ]; do
    [ -n "$local_ref$local_sha$remote_ref$remote_sha$extra" ] || continue
    [ -n "$local_ref" ] && [ -n "$local_sha" ] && [ -n "$remote_ref" ] &&
        [ -n "$remote_sha" ] && [ -z "$extra" ] || refuse "malformed record"
    [ "$local_sha" != "$zero" ] || refuse "deletions are not development pushes"
    merging=0
    case "$remote_ref" in
        refs/heads/main) merging=1 ;;
        refs/heads/?*) ;;
        *) refuse "only branches are pushed: a tag or another ref is not" ;;
    esac
    git check-ref-format "$remote_ref" >/dev/null 2>&1 || refuse "invalid destination ref"
    case "$local_sha$remote_sha" in *[!0-9a-f]*) refuse "invalid commit identifier" ;; esac
    [ "$(git --no-replace-objects cat-file -t "$local_sha" 2>/dev/null || true)" = commit ] ||
        refuse "local tip is not a known commit"
    if [ "$merging" = 1 ]; then
        why=$(release_refusal "$local_sha")
        [ -z "$why" ] || refuse "$why"
    fi
    if [ "$remote_sha" != "$zero" ]; then
        [ "$(git --no-replace-objects cat-file -t "$remote_sha" 2>/dev/null || true)" = commit ] ||
            refuse "fetch the remote commit before pushing"
        git --no-replace-objects merge-base --is-ancestor "$remote_sha" "$local_sha" ||
            refuse "the update is not a fast-forward"
    fi
done
