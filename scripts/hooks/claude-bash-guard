#!/usr/bin/env python3
"""A PreToolUse hook on Bash and Monitor that refuses shell commands that harm other agents' work, the broker or the repository.

Claude Code runs this before every Bash and Monitor call. Exit 2 blocks the command and hands the
message back. A command the guard fails on, or cannot judge in time, is blocked the same way (`rules_loader.closed`); rule files
that do not load leave the built-in hard rules only (`rules_loader.usable`).
Set POOLHOUSE_GUARD=off to disable the soft rules for a session; the hard rules (pushes of main, tags,
force and deletions, minting identities, the person folder) stay in force. Every refusal is decided here, at once, and says why
and what to do instead: nothing waits for a person.

Wire it in as a PreToolUse hook on Bash and Monitor in a project's `.claude/settings.json`:

    {"hooks": {"PreToolUse": [{"matcher": "Bash|Monitor", "hooks": [
        {"type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/claude-bash-guard"}]}]}}

A project that wants its own wiring writes a thin `sh` wrapper that execs this file with
stdin passed through, and exits 0 with a note when this copy is missing -- a missing guard
must not block every Bash call.
"""

from __future__ import annotations

import functools
import json
import re
import shlex
import sys
from collections.abc import Callable
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import rules_loader

# The start of a command, past any NAME=value the caller put in front of it.
RUN = r"(^|[;&|(]\s*|\bthen\s+|\bdo\s+|\bexec\s+)(\w+=\S*\s+)*"

# The start of a git push: a command start, a quote (sh -c "..."), or an env / sudo / command prefix.
PUSHER = (r"(^|[;&|(]\s*|\bthen\s+|\bdo\s+|\bexec\s+|[\"'`]\s*|\bsudo\s+|\bcommand\s+"
          r"|\benv\s+(-\S+\s+(\w+\s+)?|\w+=\S*\s+)*)(\w+=\S*\s+)*")
GIT_PUSH = r"git\s+(-[Cc]\s+\S+\s+|--\S+\s+)*push\b"

# The remote-tracking refs record what the remote holds and the push checks compare the code with them: only fetch and push move them.
MOVE_REMOTE_REFS = (PUSHER + r"git\s+(-[Cc]\s+\S+\s+|--\S+\s+)*(update-ref|symbolic-ref)\b[^;&|\n]*((refs/)?remotes/|--stdin)"
                    r"|" + PUSHER + r"git\s+(-[Cc]\s+\S+\s+|--\S+\s+)*(fetch|pull|push)\b[^;&|\n]*:\+?(refs/)?remotes/")
PUSH_MAIN = PUSHER + GIT_PUSH + r"[^;&|\n]*\bmain\b"
PUSH_FLAGS = (PUSHER + GIT_PUSH + r"[^;&|\n]*(--all\b|--mirror\b|--tags\b|--delete\b"
              r"|--force|\s-f\b|\s-d\b)")
MINT = RUN + r"(\S*/)?poolhouse-workspace\s+(-\S+\s+)*(mint|delegate)\b"
PERSON_STORE = (r"\.poolhouse/person\b|person/harness-sessions|\bCLAUDE_CONFIG_DIR=|"
                r"(import|from)\s+poolhouse\.workspace(\.|\s+import\s+[^;\n]*\b)harness_ancestry|"
                r"-m\s+poolhouse\.workspace\.harness_ancestry|"
                + RUN + r"(\S*python\S*\s+|(ba)?sh\s+)?(\S*/)?claude-harness-bind")
SKIP_HOOKS = (PUSHER + r"git\s+(-[Cc]\s+\S+\s+|--\S+\s+)*(commit|push|merge|am|cherry-pick|rebase)\b[^;&|\n]*"
              r"(--no-verify\b|--no-gpg-sign\b)"
              r"|" + PUSHER + r"git\s+(-[Cc]\s+\S+\s+|--\S+\s+)*commit\b[^;&|\n]*\s-[a-zA-Z]*n[a-zA-Z]*(\s|$)"
              r"|(^|[;&|]\s*|\benv\s+)SKIP_BUDGETS=")
# Every `git stash` subcommand but the read-only `list` and `show`: the stash stack is one for all worktrees.
STASH = RUN + r"git\s+(-[Cc]\s+\S+\s+|--\S+\s+)*stash\b(?!\s+(list|show)\b)"
STASH_MESSAGE = (
    "Do not use `git stash` (push, save, pop, apply, drop, clear, branch, create, store): the stash is shared by "
    "every worktree, so one agent's pop or drop takes another agent's work. Commit work in progress to your own "
    "branch instead (a `wip:` commit you can amend or undo with `git reset --soft HEAD~1`), or use `git worktree` "
    "for a second copy. Read-only `git stash list` and `git stash show` are allowed.\n"
    "Fail-first without a stash, after committing: `git restore --source=<parent-sha> -- <changed source files>`, "
    "run the test, then `git restore --source=HEAD -- <those files>`; or a throwaway "
    "`git worktree add <scratchpad>/parent <parent-sha>` (remove it with `git worktree remove --force` after).\n"
    "Merging with local changes: make a WIP commit first, then `git merge origin/<dev>`.")

# (what it matches, what to do instead). Ordered: the first match wins.
REFUSE = [
    (RUN + r"git\s+add\s+(-A\b|--all\b|\.(\s|$)|-u\b|--update\b)|"
     + RUN + r"git\s+commit\s+(-a\b|-am\b|--all\b)",
     "Do not stage everything. `git add -A` (and `add .`, `add -u`, `commit -a`) sweeps in "
     "whatever another agent is halfway through writing -- it committed a failing test once, "
     "under somebody else's commit message. Name the files you mean: `git add path/one.py "
     "path/two.py`."),
    (STASH, STASH_MESSAGE),
    (RUN + r"(sudo\s+|env\s+|time\s+|nice\s+|nohup\s+)*(\S*/)?llama-server(\s|$)",
     "Do not start llama-server by hand. `poolhouse-serve up MODEL --context 256k` asks the "
     "broker for a lease: it checks the memory, queues behind other leases, picks the port "
     "(a port another process holds is never fought over), applies the measured profile and "
     "keeps the server up until `poolhouse-serve down MODEL`. A server started by hand "
     "skips all of that and the next lease refuses."),
    (r"\bPOOLHOUSE_BROKER_LOCAL=",
     "POOLHOUSE_BROKER_LOCAL runs a private broker inside the process, with no queue and no "
     "view of the machine's other servers; it is for the tests. Ask the machine's broker: "
     "`poolhouse-serve up MODEL`."),
    (RUN + r"poolhouse-serve\s+up\b[^;&|\n]*\s(--direct|--no-broker|--no-lease|--anyway|"
     r"--unmanaged|--no-queue)\b",
     "`poolhouse-serve up` is a lease and no flag skips the broker. Drop the flag: "
     "`poolhouse-serve up MODEL --context N` (add --no-wait to return while it is queued)."),
    (r"\bpkill\b[^|;]*llama|\bkillall\b[^|;]*llama",
     "Do not pkill llama-server. `poolhouse-serve down --port N` releases the lease too; "
     "killing the process leaves the lease behind and the next `up` refuses."),
    (PUSH_FLAGS,
     "An agent pushes one branch by name: `git push origin <branch>`. Every branch at "
     "once, a tag, a deletion and a forced push are refused to an agent, and no switch opens "
     "them."),
    (MOVE_REMOTE_REFS,
     "The remote-tracking refs (refs/remotes) record what the remote holds and the push checks compare the code with "
     "them, so only `git fetch` and `git push` move them: `git update-ref`, `git symbolic-ref` and a fetch or push whose "
     "refspec ends in refs/remotes are refused to an agent."),
    (PUSH_MAIN,
     "Work lands by pull request into the development branch: push your own branch (`git push origin HEAD`) and "
     "open one (docs/landing.md). A push to `main` publishes: release-please reads the subjects "
     "there, so it moves the release pull request and releases every commit on the branch at "
     "once. It is refused to an agent until the commit has a standing independent land-review accept "
     "(`poolhouse-workspace land-review`) and the checkout is clean; this guard decides at once and says which is missing. "
     "Release goes through a `promote/<date>` snapshot and its pull request."),
    (MINT,
     "An agent does not create identities: `poolhouse-workspace mint` and `delegate` are refused to an agent. "
     "A joined agent starts a new agent with `poolhouse-workspace invite`."),
    (PERSON_STORE,
     "The person folder (`~/.poolhouse/person`) holds the owner's keys and the harness record. An agent "
     "does not read, list or write it, import the code that records the harness process or run its hook "
     "script (`claude-harness-bind`): refused to an agent, with no switch."),
    (SKIP_HOOKS,
     "The commit and push hooks are the last checks between this tree and the owner's repository, and an "
     "agent never skips them (--no-verify, commit -n, SKIP_BUDGETS=1): fix what the hook reported, take the "
     "sites out of the tree, or say in the report that a budget is over. Skipping a hook is refused to an agent."),
    (r"(^|[;&|]\s*|\benv\s+)SKIP_NAME_CHECK=1",
     "SKIP_NAME_CHECK is refused to an agent. The hook is the last thing "
     "between a real community and a public repository. If it flagged an invented name, add "
     "it to known-fixtures.txt; if it flagged a real one, the fix is to invent one."),
]


def without_heredocs(command: str) -> str:
    """Drop heredoc bodies, which are data being written rather than commands being run.

    This guard blocked its own installation twice: the command wrote documentation *about*
    a forbidden shell into a file through a heredoc, and the pattern matched the prose. A
    rule that fires on text being written is a rule people learn to switch off -- and it
    cannot be repaired through the tool it guards, so it must not need repairing often.
    """
    kept, lines, i = [], command.split("\n"), 0
    while i < len(lines):
        kept.append(lines[i])
        opened = re.search(r"<<-?\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?", lines[i])
        if opened:
            end = opened.group(1)
            i += 1
            while i < len(lines) and lines[i].strip() != end:
                i += 1
        i += 1
    return "\n".join(kept)


SEARCHERS = r"grep|egrep|fgrep|rg|ag|ack|awk|sed|comm|diff"


QUOTED = r"'[^']*'|\"(?:\\.|[^\"\\])*\""
SEARCH = re.compile(rf"(?P<outside>\\.|{QUOTED})|\b(?:grep|egrep|fgrep|rg)\b(?:\\.|{QUOTED}|[^|;&\n'\"\\])*")
"""A grep or rg command with its quoted patterns read whole, or a quoted or escaped text outside one, which is consumed so that a closing
quote is never read as the start of a pattern."""


def without_search_patterns(command: str) -> str:
    """Drop the quoted arguments of a search command, which are text being looked for. A pattern given to grep or rg may hold `|`, `;` or
    `&`; a double-quoted one that runs a command (`$(`, a backtick) is not read whole."""
    def blank(quoted: re.Match) -> str:
        text = quoted.group(0)
        return text if text.startswith('"') and ("$(" in text or "`" in text) else "''"

    command = SEARCH.sub(lambda found: found.group(0) if found.group("outside") else re.sub(QUOTED, blank, found.group(0)), command)

    def strip(match: re.Match) -> str:
        head = match.group(0)
        return re.sub(r"'[^']*'|\"[^\"]*\"", "''", head)
    return re.sub(rf"\b({SEARCHERS})\b[^|;&\n]*", strip, command)


HARD = (PUSH_FLAGS, MOVE_REMOTE_REFS, PUSH_MAIN, MINT, PERSON_STORE, SKIP_HOOKS, STASH)
"""Patterns that stay in force when POOLHOUSE_GUARD=off is set: this guard only ever runs on an agent's call."""

MESSAGE = re.compile(r"(-m|--message)(\s+|=)('[^']*'|\"[^\"]*\")")


LEAD_SELECTORS = ("CLAUDE_CODE_SESSION_ID", "POOLHOUSE_SESSION_ID", "POOLHOUSE_SESSION_HARNESS", "CODEX_THREAD_ID")
"""How the harness names the session that started a subagent. The shell inherits them; the stamp takes them out, so a command of
the subagent that drops its own marker finds no identity to fall back on, and not the lead's."""

SHELL_TOOLS = ("Bash", "Monitor")
"""The tools that run a shell command in the environment of the session: both meet these rules and both are stamped."""


def subagent_naming_another(event: dict, command: str, rules) -> str:
    """Why a subagent's command acts as another session (`--agent`, a token file, a token, the agent variable), else an empty string.

    A subagent's shell inherits the environment of the session that started it, so what it names is what it acts as."""
    agent = str(event.get("agent_id") or "")
    if not agent:
        return ""
    import subagent_records
    return rules.protected().other_agent(command, str(subagent_records.load(agent).get("name") or ""))


def stamp(agent: str) -> str:
    """The lines, each ended, that set the identity of the subagent with harness id ``agent`` in the shell of its command."""
    import subagent_records
    record = subagent_records.load(agent)
    lines = [f"export POOLHOUSE_SUBAGENT={shlex.quote(subagent_records.native_key(agent))}",
             "unset POOLHOUSE_WORKSPACE_TOKEN", *(f"unset {name}" for name in LEAD_SELECTORS)]
    lines.append(f"export POOLHOUSE_WORKSPACE_AGENT={shlex.quote(record['name'])}" if record.get("name")
                 else "unset POOLHOUSE_WORKSPACE_AGENT")
    if record.get("board"):
        lines.append(f"export POOLHOUSE_BOARD={shlex.quote(record['board'])}")
    return "".join(f"{line}\n" for line in lines)


def unstamped(event: dict) -> dict | None:
    """The event of a subagent's command that already begins with exactly this subagent's own stamp, holding the command after it;
    None for any other. A permission mode that refuses a command a hook changed lets the subagent send the changed command itself:
    those first lines are this guard's, so the rules judge what follows them and nothing is added a second time."""
    agent, given = str(event.get("agent_id") or ""), event.get("tool_input")
    command = given.get("command") if isinstance(given, dict) else None
    if not agent or not isinstance(command, str) or not command.startswith("export POOLHOUSE_SUBAGENT="):
        return None   # the record is read before the rules judge only for a command that could be a stamped one
    if not command.startswith(own := stamp(agent)):
        return None
    return {**event, "tool_input": {**given, "command": command[len(own):]}}


def unidentified(why: Exception) -> int:
    """Refuse a subagent's command that could not be judged or given its identity: a hook that crashes lets the command run, as the
    session that started the subagent."""
    print(f"blocked: this subagent's command could not be judged as its own ({type(why).__name__}), so it does not run.\n\n"
          "(poolhouse scripts/hooks/claude-bash-guard. No switch opens this rule.)", file=sys.stderr)
    return 2


ACTS_AS_A_SESSION = re.compile(
    r"(?:^|[\s;&|(`'\"=]|bin/)poolhouse(?:-[a-z]+)*(?=$|[\s;&|)`'\"<>])|-m\s*poolhouse\b|POOLHOUSE_|\bgit\b[^;&|\n]*\b(?:commit|push)\b"
    r"|\blead-review\b", re.M)
"""A command that acts as a session: it runs a poolhouse program or module, reads a Poolhouse variable, commits or pushes (whose hooks do),
or reviews a pull request (`scripts/lead-review` refuses the author, so it must know who runs it)."""


def subagent_stamped(event: dict, given: dict) -> dict | None:
    """The tool input of a subagent's command with the subagent's identity set in the shell, or None for any other caller. The auto permission
    mode refuses a command a hook changed, so there only a command that acts as a session (`ACTS_AS_A_SESSION`) is changed.

    The shell inherits the identity of the session that started the subagent; the start hook's record of the subagent
    replaces it, and a subagent with no record has none, so its workspace commands are refused."""
    agent, command = str(event.get("agent_id") or ""), given.get("command")
    if not agent or not isinstance(command, str):
        return None
    if event.get("permission_mode") == "auto" and not ACTS_AS_A_SESSION.search(command):
        return None
    return {**given, "command": stamp(agent) + command}


def judge(event: dict, switched: bool, rules) -> str:
    """The text that refuses the shell command of ``event``, or an empty string when it may run."""
    raw = (event.get("tool_input") or {}).get("command") or ""
    why = ""
    if rules:
        check = rules.hard_bash_refusal if switched else rules.bash_refusal
        why = check(raw, event.get("cwd") or "") or subagent_naming_another(event, raw, rules)
    if why:
        return (f"blocked: {why}\n\n(poolhouse scripts/hooks/claude-bash-guard. Set "
                f"POOLHOUSE_GUARD=off switches off the soft rules only.)")
    release = functools.lru_cache(maxsize=None)(
        rules.release_refusal if rules else lambda _: "the release rules could not be loaded")
    cwd = event.get("cwd") or ""
    if why := matched([without_heredocs(raw)], switched, lambda: release(cwd)):
        return why
    # then every other way the command reads, which only adds a refusal: the first has been judged whatever these take
    others = rules.protected().other_texts(raw, rules.protected().blanked) if rules else []
    return matched(others, switched, lambda: release(cwd))


def matched(readings: list[str], switched: bool, release: Callable[[], str]) -> str:
    """The text that refuses a command by the patterns of `REFUSE`, met in any of ``readings``; ``release`` says why a push of
    main may not run now."""
    if any(rules_loader.too_long_to_match(text) for text in readings):
        return ("blocked: the command is longer than the guard's patterns finish in time on under this Python: put the data in a "
                "file or a heredoc, or split the command.\n\n(poolhouse scripts/hooks/claude-bash-guard. No switch opens this rule.)")
    commands = [MESSAGE.sub(r"\1 ''", without_search_patterns(text)) for text in readings]
    for pattern, instead in REFUSE:
        if switched and pattern not in HARD:
            continue
        if any(re.search(pattern, command, re.M) for command in commands):
            if pattern is PUSH_MAIN and not any(re.search(PUSH_FLAGS, command) for command in commands):
                missing = release()
                if not missing:
                    continue
                instead = f"{instead} Right now: {missing}."
            tail = ("No switch opens this rule." if pattern in HARD else
                    "If this is genuinely the right command, say so in the report, "
                    "or set POOLHOUSE_GUARD=off.")
            return f"blocked: {instead}\n\n(poolhouse scripts/hooks/claude-bash-guard. {tail})"
    return ""


def decide() -> int:
    switched = rules_loader.guard_off()
    try:
        event = rules_loader.event()
    except RecursionError:
        print(rules_loader.NESTED, file=sys.stderr)
        return 2
    if event.get("tool_name") not in SHELL_TOOLS:
        return 0
    rules, broken = rules_loader.usable()
    if broken:  # only the patterns that need no rule file apply, those no switch opens, so the files can still be mended
        print(f"poolhouse claude-bash-guard: the rules did not load ({broken}); only the built-in hard rules apply.", file=sys.stderr)
        switched = True
    if rules and rules.protected().too_deep(event):
        print(rules_loader.NESTED, file=sys.stderr)
        return 2
    try:
        own = unstamped(event)
        refused = judge(own or event, switched, rules)
        stamped = None if refused or own else subagent_stamped(event, event.get("tool_input") or {})
    except Exception as why:
        if not event.get("agent_id"):
            raise
        return unidentified(why)
    if refused:
        print(refused, file=sys.stderr)
        return 2
    if stamped:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": stamped}}))
    return 0


def main() -> int:
    return rules_loader.closed(decide, "claude-bash-guard")


if __name__ == "__main__":
    raise SystemExit(main())
