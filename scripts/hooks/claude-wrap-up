#!/usr/bin/env python3
"""A PostToolUse hook: counts a subagent's tool calls (the event's `agent_id` names it; a repeated `tool_use_id` counts once),
tells the subagent at 120 and again at 140 to commit, push, clean up and report, and tells the lead when it reaches 100 calls
and every 50 after (`milestones`; the interval is POOLHOUSE_TOOL_MILESTONE_EVERY). The notice informs and never limits.

The count is cleared by the SubagentStop hook. The main session (no agent_id) is not counted.

Wire it in as a PostToolUse hook in `.claude/settings.json`:

    {"hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/claude-wrap-up", "timeout": 15}]}
"""

from __future__ import annotations

import json
import sys

import milestones
import wrap_up


def main() -> int:
    try:
        event = json.load(sys.stdin)
        agent = str(event.get("agent_id") or "") if isinstance(event, dict) else ""
        count = wrap_up.record(agent, str(event.get("tool_use_id") or "")) if agent else 0
    except (OSError, ValueError) as error:
        print(f"workspace PostToolUse: tool-call count not recorded: {error}", file=sys.stderr)
        return 0
    text = "\n\n".join(part for part in (wrap_up.warning(agent, count), milestones.check(event, agent, count)) if part) if count else ""
    if text:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": text}}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
