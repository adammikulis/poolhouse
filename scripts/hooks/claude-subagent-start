#!/usr/bin/env python3
"""A SubagentStart hook: puts the worktree rule and the development branch in a subagent's context."""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import rules_loader
import subagent_records
import tree_watch
import workspace_hook


ALIASES = {"sonnet": "claude-sonnet-5-5", "opus": "claude-opus-5-5", "haiku": "claude-haiku-5-5",
           "fable": "claude-fable-5-1"}


def definition_model(event: dict) -> str:
    """The model id an agent definition's `model:` names, or an empty string when it inherits."""
    kind = str(event.get("agent_type") or "")
    root = Path(event.get("cwd") or ".")
    for path in (root / ".claude" / "agents" / f"{kind}.md", Path.home() / ".claude" / "agents" / f"{kind}.md"):
        try:
            head = path.read_text().split("---")[1]
        except (OSError, IndexError):
            continue
        for line in head.splitlines():
            key, _, value = line.partition(":")
            if key.strip() == "model":
                value = value.strip()
                return ALIASES.get(value, value if value.startswith("claude-") else "")
    return ""


def register(event: dict, parent: dict) -> tuple[dict, str]:
    """Ask the board to register this subagent as a child of whoever started it; (answer, "") or ({}, why not)."""
    agent = str(event.get("agent_id") or "")
    if not agent:
        reason = "the event has no agent_id"
        workspace_hook.warning("SubagentStart", f"{reason}; the subagent cannot be given its own name")
        return {}, reason
    command = ["poolhouse-workspace", "spawn", "--session", subagent_records.native_key(agent), "--harness", "claude-code",
               "--json"]
    model = definition_model(event)
    if model:
        command += ["--model", model]
    done = workspace_hook.attempt(command, "SubagentStart", environment=parent)
    if done is None:
        return {}, "the board did not answer"
    if done.returncode:
        reason = " ".join((done.stderr or done.stdout or "no reason given").split())[:300]
        workspace_hook.warning("SubagentStart", f"command exited {done.returncode}: {reason}")
        return {}, reason
    try:
        return json.loads(done.stdout), ""
    except ValueError:
        return {}, "the board's answer was not JSON"


def unregistered(event: dict, parent: dict, why: str) -> str:
    """Tell the starting session on the board, and the subagent in its context, that it has no identity."""
    kind = " ".join(str(event.get("agent_type") or "subagent").split())[:40]
    workspace_hook.run(["poolhouse-workspace", "announce", "blocked",
                        f"subagent {event.get('agent_id')} ({kind}) has no identity: {why}"[:200]],
                       "SubagentStart", environment=parent)
    return (f"The harness could not register you on the board ({why}). A workspace command of yours is refused, because it would "
            "run as the session that started you: put your result in your final message and the session that started you records it.")


def workspace_brief(event: dict) -> str:
    """Register the subagent as its own identity, announce it as itself and return its brief."""
    parent = workspace_hook.parent_environment(event, "SubagentStart")
    if parent is None:
        return ""
    made, why = register(event, parent)
    if not made:
        return unregistered(event, parent, why)
    subagent_records.save(str(event["agent_id"]), name=made["id"], parent=made["parent"], board=made.get("board", ""))
    environment = workspace_hook.own_environment(event, "SubagentStart")
    if environment is None:
        return ""
    purpose = " ".join(str(event.get("description") or event.get("agent_type") or "subagent").split())[:190]
    tree_watch.started("SubagentStart", str(event.get("cwd") or ""),
                       environment.get("POOLHOUSE_WORKSPACE_AGENT", ""), purpose)
    workspace_hook.run(["poolhouse-workspace", "announce", "joined", purpose], "SubagentStart", environment=environment)
    done = workspace_hook.run(["poolhouse-workspace", "brief", "--registered"],
                              "SubagentStart", environment=environment)
    return done.stdout.strip() if done else ""


def main() -> int:
    event = workspace_hook.event("SubagentStart")
    if event is None:
        return 0
    rules = rules_loader.load()
    try:
        found = rules.checkouts(event.get("cwd") or ".") if rules else None
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError) as error:
        workspace_hook.warning("SubagentStart", error)
        found = None
    parts = [workspace_brief(event)]
    if found:
        parts.append(checkout_rule(found[1]))
    text = "\n\n".join(p for p in parts if p)
    if not text:
        return 0
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SubagentStart",
                                             "additionalContext": text}}))
    return 0


def checkout_rule(primary: Path) -> str:
    done = workspace_hook.run(["git", "-C", str(primary), "branch", "--show-current"], "SubagentStart")
    dev = done.stdout.strip() if done else "unknown"
    return (f"Checkout rule: the primary checkout {primary} is on the development branch {dev}. "
            "Use it when that is the best way to complete the task; concurrent writers, experiments "
            "and conflicts require separate sibling worktrees and branches. Acquire authenticated "
            "claims before mutation, preserve unrelated work, and stage files by name. "
            "Independent review and affected tests are required. Never use editable installs "
            "or commit or push main without the owner's explicit instruction.")


if __name__ == "__main__":
    raise SystemExit(main())
