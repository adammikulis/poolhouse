#!/usr/bin/env python3
"""Refuse a commit whose staged files add a site to any budgeted metric.

A budget only ever falls. Staged content is compared against HEAD's, file by file, so
this reads only what is being committed.

Override: SKIP_BUDGETS=1 git commit ...   only after reading what it flagged.
"""

from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
sys.path.insert(0, str(HERE))

import gates  # noqa: E402
import renames  # noqa: E402
from gates import glossary_words  # noqa: E402

ROOT = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
BUDGETS = ROOT / "budgets.json"


def _git(*args: str) -> str:
    done = subprocess.run(
        ["git", *args], cwd=ROOT, capture_output=True, text=True, check=False
    )
    return done.stdout if done.returncode == 0 else ""


def staged() -> dict[str, str]:
    """``{path: where its old content is}`` for the .py files this commit adds, changes, renames or deletes.

    A renamed file's old content is at its old path, so its sites are counted against that and not
    against nothing. A copy is an addition.
    """
    out = _git("diff", "--cached", "--name-status", "-z", renames.FLAG, "--diff-filter=ACMRD")
    return {new: old if status == "R" and old.endswith(".py") else new
            for status, old, new in renames.pairs(out) if new.endswith(".py")}


CONFIG = "pyproject.toml"
POLICY = ("contracts/glossary-rules.toml", "contracts/glossary-allowlist.toml")


def plant(base: Path, names: list[str], revision: str, origin: dict[str, str] | None = None) -> None:
    """Write each file's content at the given revision under base, read from its old path if it has one."""
    for name in names:
        if name in POLICY:
            entry = (_git("ls-tree", revision, "--", name) if revision
                     else _git("ls-files", "--stage", "--", name))
            if not entry.startswith("100644 ") and not entry.startswith("100755 "):
                raise ValueError("Vocabulary policy must be a tracked regular file")
        text = _git("show", f"{revision}:{(origin or {}).get(name, name)}")
        if not text:
            continue
        target = base / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text, encoding="utf-8")


def counts(base: Path, names: list[str]) -> dict[str, Counter[str]]:
    """Each metric's findings under base, counted by the file they are in."""
    out: dict[str, Counter[str]] = {}
    for name, found in gates.run(base).items():
        out[name] = Counter(f.path for f in found if f.path in names)
    return out


def main() -> int:
    """Compare staged content against HEAD and refuse any added site."""
    if os.environ.get("SKIP_BUDGETS") and not any(os.environ.get(m) for m in ("CLAUDECODE", "POOLHOUSE_AGENT")):
        return 0  # a person's override; an agent's is ignored, as the budget rise below is refused to it
    if not BUDGETS.exists():
        return 0
    if _git("rev-parse", "-q", "--verify", "MERGE_HEAD").strip():
        # a merge brings in commits that passed this hook already, and `scripts/test gate`
        # (the shared gate) counts every metric over the whole tree; re-counting the
        # whole merge here took 65 s for a 675-file merge (docs/test-time.md)
        return 0
    origin = staged()
    names = list(origin)
    policy_changed = set(_git("diff", "--cached", "--name-only", "-z").split("\0")) & set(POLICY)
    if not names and not policy_changed:
        return 0

    has_head = bool(_git("rev-parse", "--verify", "HEAD"))
    with tempfile.TemporaryDirectory() as tmp:
        new_root = Path(tmp) / "staged"
        old_root = Path(tmp) / "head"
        new_root.mkdir()
        old_root.mkdir()
        plant(new_root, [*names, CONFIG, *POLICY], "")
        if has_head:
            plant(old_root, [*names, CONFIG, *POLICY], "HEAD", origin)
        for base in (new_root, old_root):
            if not (base / CONFIG).exists():
                (base / CONFIG).write_text((ROOT / CONFIG).read_text(encoding="utf-8"),
                                           encoding="utf-8")
        lib = glossary_words._nomenclature()
        lib.Vocabulary(root=new_root)
        if has_head:
            lib.Vocabulary(root=old_root)
        if not names:
            return 0
        after = counts(new_root, names)
        before = counts(old_root, names) if has_head else {}
        sites = gates.run(new_root)

    owner = {c.NAME: c.OWNER for c in gates.checkers()}
    described = {c.NAME: c.describe() for c in gates.checkers()}
    refused = 0
    for metric in sorted(after):
        added = sum(after[metric].values()) - sum(before.get(metric, Counter()).values())
        if added <= 0:
            continue
        refused = 1
        where = owner.get(metric) or "no owner"
        print(
            f"budgets: {metric} gains {added} site(s) -- {described[metric]}",
            file=sys.stderr,
        )
        print(f"  owned by {where}", file=sys.stderr)
        for finding in [f for f in sites[metric] if f.path in names][:10]:
            print(f"    {finding.path}:{finding.line}  {finding.detail}", file=sys.stderr)
    if refused:
        print(
            "\nA budget only falls. Use what already owns the job"
            + ("." if os.environ.get("CLAUDECODE") or os.environ.get("POOLHOUSE_AGENT")
               else ", or SKIP_BUDGETS=1 git commit ... after reading the above."),
            file=sys.stderr,
        )
    return refused


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ValueError as exc:
        print(f"budgets: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
